<div class="w-13 h-13 shrink-0 rounded-[9px] overflow-hidden bg-(--rg-s2) shadow-[0_6px_16px_rgba(0,0,0,0.2)] dark:shadow-[0_6px_16px_rgba(0,0,0,0.4)]">
    {#if g.cover.is_some()}
        <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&g.cover)} alt="">
    {/if}
</div>
<div class="flex-1 min-w-0 flex flex-col gap-0.75">
    <div class="truncate text-[17px] font-extrabold tracking-[-0.01em] text-(--rg-tx)" title={g.title.as_str()}>{g.title}</div>
    <div class="flex items-center gap-2 whitespace-nowrap overflow-hidden text-[13px] text-(--rg-mu)">
        {#if let Some(y) = &g.year}<div>{y}</div><div>·</div>{/if}
        <div>{g.tracks_count}</div>
        <div>·</div>
        <div>{g.duration}</div>
        {#if let Some(q) = &g.quality}<QualityBadge tier={q.0} text={q.1.clone()} />{/if}
    </div>
</div>
{#if let Some(route) = &g.album_route}
    <button class="h-8.5 pl-3 pr-2 shrink-0 flex items-center gap-0.5 rounded-[9px] text-[13px] font-semibold cursor-pointer transition-colors text-(--rg-mu) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
            onclick={Msg::Go(route.clone())}>
        <div>{t("artist_view.open_album")}</div>
        <Icon icon="material-symbols:chevron-right-rounded" width={20} />
    </button>
{/if}
