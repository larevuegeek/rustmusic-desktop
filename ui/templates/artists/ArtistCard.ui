<button class="card-artist group relative w-full flex flex-col items-center gap-2.5 min-w-0 text-center cursor-pointer"
        onclick={Msg::Go(artist.route.clone())}>
    <div class="relative w-full aspect-square">
        <div class="absolute inset-0 rounded-full overflow-hidden bg-(--rg-s2) shadow-[0_12px_18px_-10px_rgba(0,0,0,0.35)] dark:shadow-[0_12px_20px_-10px_rgba(0,0,0,0.7)]">
            {#if artist.portrait.is_some()}
                <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&artist.portrait)} alt="">
            {:else if artist.avatar.is_some()}
                {#if let Some(av) = &artist.avatar}
                    <div class="avatar-artiste w-full h-full rounded-full flex items-center justify-center font-bold text-[52px] tracking-[-0.02em]" style:--h={av.1}>{av.0}</div>
                {/if}
            {:else}
                <div class="absolute inset-0 rounded-full flex flex-col items-center justify-center gap-1.5 text-[11px] font-semibold text-(--rg-mu)
                            bg-(--rg-s2) shadow-[inset_0_0_0_1px_var(--rg-bd)]">
                    <Icon icon="material-symbols:person-outline-rounded" width={34} />
                    <div>{t("artists_view.missing_portrait")}</div>
                </div>
            {/if}
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors duration-150 pointer-events-none"></div>
        </div>
        <button class="absolute right-1 top-1 z-2 w-7.5 h-7.5 rounded-lg flex items-center justify-center cursor-pointer
                       bg-black/55 text-white opacity-0 group-hover:opacity-100 transition-opacity hover:bg-black/75"
                title={t("artists_view.more")} aria-label={t("artists_view.more")} onclick={Msg::Noop}>
            <Icon icon="material-symbols:more-horiz" width={18} />
        </button>
        <button class="absolute right-[7%] bottom-[7%] z-2 w-11 h-11 rounded-full flex items-center justify-center cursor-pointer
                       bg-(--rg-g) text-(--rg-on-g) shadow-[0_6px_16px_rgba(0,0,0,0.5)]
                       opacity-0 translate-y-1.5 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-150 hover:scale-105"
                title={t("artists_view.play")} aria-label={t_with("artists_view.play_named", &[("name", &artist.name)])} onclick={artist.play.clone()}>
            <Icon icon="material-symbols:play-arrow-rounded" width={28} />
        </button>
    </div>

    <div class="w-full text-[15px] font-bold leading-[1.3] truncate text-(--rg-tx)" title={artist.name.as_str()}>{artist.name}</div>
    <div class="-mt-1.5 w-full truncate text-[13px] text-(--rg-mu)">{artist.counts}</div>
</button>
