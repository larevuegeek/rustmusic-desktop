<div class="h-full">
{#each self.views.artist.iter() as page (page.id.as_str())}
{#if page.artist.is_none() && !page.error}
    <div class="flex items-center justify-center h-full text-(--rg-mu)"><Spinner width={26.} /></div>
{:else if page.artist.is_none()}
    <div class="flex flex-col items-center justify-center gap-3 h-full text-(--rg-mu)">
        <Icon icon="material-symbols:person-outline-rounded" width={34} />
        <p class="text-sm m-0">{t("artist_view.error")}</p>
        <button class="text-sm font-semibold text-(--rg-gtx) hover:underline cursor-pointer" onclick={Msg::Go(Route::Library(Section::Artists))}><div>{t("artist_view.back")}</div></button>
    </div>
{:else}
{#if let Some(av) = self.artist_view()}
<div class="relative h-full overflow-y-auto scrollbar-app">
    <div class="album-lueur absolute inset-x-0 top-0 h-115 pointer-events-none" style:--h={av.tint.0} style:--s={av.tint.1}></div>

    <div class="@container relative max-w-350 px-4 md:px-8 pb-24" style:margin_top={-self.export_offset}>
        <div class="z-20 h-15 -mx-4 md:-mx-8 px-4 md:px-8 flex items-center gap-3 border-b border-transparent">
            <button class="h-8.5 pl-2 pr-3 shrink-0 flex items-center gap-1.5 rounded-[9px] text-sm font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                    onclick={Msg::Go(Route::Library(Section::Artists))}>
                <Icon icon="material-symbols:arrow-back-rounded" width={20} />
                <div>{t("artist_view.back")}</div>
            </button>
            <div class="flex-1"></div>
            {@include "../shared/inputs/ViewSwitch.ui"}
        </div>

        <div class="relative flex flex-wrap items-end gap-8 pt-3 pb-7">
            <div class="relative w-55 aspect-square shrink-0 rounded-full overflow-hidden shadow-[0_24px_60px_rgba(0,0,0,0.3)] dark:shadow-[0_24px_60px_rgba(0,0,0,0.55)]">
                {#if av.portrait.is_some()}
                    <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&av.portrait)} alt="">
                {:else}
                    <div class="w-full h-full flex items-center justify-center text-(--rg-mu) bg-(--rg-s2)">
                        <Icon icon="material-symbols:person-rounded" width={96} />
                    </div>
                {/if}
                <div class="absolute inset-0 rounded-full ring-1 ring-inset ring-black/5 dark:ring-white/6 pointer-events-none"></div>
            </div>

            <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-3">
                <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold tracking-[0.1em] uppercase text-(--rg-tx2)">
                    <div>{t("artist_view.kicker")}</div>
                </div>
                {#if av.name_long}
                    <h1 class="m-0 font-extrabold leading-[1.12] tracking-[-0.03em] line-clamp-2 text-(--rg-tx) text-[56px]" title={av.name.as_str()}>{av.name}</h1>
                {:else}
                    <h1 class="m-0 font-extrabold leading-[1.12] tracking-[-0.03em] line-clamp-2 text-(--rg-tx) text-[72px]" title={av.name.as_str()}>{av.name}</h1>
                {/if}

                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px] text-(--rg-mu)">
                    {#if let Some(a) = &av.albums_n}
                        <div class="flex gap-1"><div class="font-bold text-(--rg-tx)">{a.0}</div><div>{a.1}</div></div>
                        <div class="text-(--rg-mu2)">·</div>
                    {/if}
                    <div class="flex gap-1"><div class="font-bold text-(--rg-tx)">{av.tracks_n.0}</div><div>{av.tracks_n.1}</div></div>
                    {#if !av.duration.is_empty()}<div class="text-(--rg-mu2)">·</div><div>{av.duration}</div>{/if}
                    {#if let Some(p) = &av.period}<div class="text-(--rg-mu2)">·</div><div>{p}</div>{/if}
                </div>

                <div class="flex flex-wrap items-center gap-2.5 mt-2">
                    <PlayButton large label={t("artist_view.play_all")} onclick={Msg::Artist(ArtistMsg::PlayAll)} />
                    <RoundButton icon="material-symbols:shuffle-rounded" title={t("album_view.shuffle")} disabled={!av.has_tracks} onclick={Msg::Artist(ArtistMsg::Shuffle)} />
                    {#if av.liked_all}
                        <RoundButton icon="material-symbols:favorite-rounded" pressed title={t("album_view.fav_remove")} onclick={Msg::Artist(ArtistMsg::LikeAll)} />
                    {:else}
                        <RoundButton icon="material-symbols:favorite-outline-rounded" disabled={!av.has_tracks} title={t("album_view.fav_add")} onclick={Msg::Artist(ArtistMsg::LikeAll)} />
                    {/if}
                    <RoundButton icon="material-symbols:more-horiz" title={t("album_view.more")} onclick={Msg::Noop} />
                    {#if !av.genres.is_empty()}
                        <div class="flex flex-wrap gap-1.5 ml-1.5">
                            {#each av.genres as g (g.as_str())}
                                <ChipLink label={g.clone()} title={t("album_view.genre_title")} onclick={Msg::Go(Route::Genre(g.clone()))} />
                            {/each}
                        </div>
                    {/if}
                </div>
            </div>
        </div>

        {#each av.discography.iter() as c (c.id)}
            <div class="-mt-9">{@include "../albums/AlbumCarousel.ui"}</div>
        {/each}

        <section class="mt-12">
            <div class="flex flex-col gap-1 mb-2">
                <h2 class="m-0 text-[22px] font-extrabold tracking-[-0.01em] text-(--rg-tx)">{t("artist_view.all_tracks")}</h2>
                <div class="text-[13px] text-(--rg-mu)">{av.subtitle}</div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5 pt-1 pb-3.5">
                <div class="mr-auto flex gap-1 text-[13px] text-(--rg-mu)">
                    <div class="font-semibold text-(--rg-tx2)">{av.tracks_n.0}</div>
                    <div>{av.tracks_n.1}</div>
                    {#if !av.duration.is_empty()}<div>· {av.duration}</div>{/if}
                </div>
                <div class="flex shrink-0 p-0.75 rounded-[10px] border bg-(--rg-carte) border-(--rg-bd)" role="radiogroup" aria-label={t("common.sort")}>
                    {#each av.sorts as s (s.key)}
                        {#if s.active}
                            <button role="radio" aria-checked="true" class="flex items-center justify-center gap-1 rounded-[7px] text-[13px] font-semibold cursor-pointer whitespace-nowrap h-7 px-3 bg-(--rg-s2) text-(--rg-tx)"
                                    onclick={Msg::Artist(ArtistMsg::Sort(s.key.to_string()))}>
                                <div>{s.label}</div>
                                {#if let Some(a) = &s.arrow}<Icon icon={*a} width={14} />{/if}
                            </button>
                        {:else}
                            <button role="radio" aria-checked="false" class="flex items-center justify-center gap-1 rounded-[7px] text-[13px] font-semibold cursor-pointer whitespace-nowrap h-7 px-3 text-(--rg-mu) hover:text-(--rg-tx)"
                                    onclick={Msg::Artist(ArtistMsg::Sort(s.key.to_string()))}>
                                <div>{s.label}</div>
                            </button>
                        {/if}
                    {/each}
                </div>
                {#if let Some(open) = &av.all_open}
                    {#if *open}
                        <ToolbarButton icon="material-symbols:unfold-less-rounded" label={t("artist_view.collapse_all")} onclick={Msg::Artist(ArtistMsg::ToggleAll)} />
                    {:else}
                        <ToolbarButton icon="material-symbols:unfold-more-rounded" label={t("artist_view.expand_all")} onclick={Msg::Artist(ArtistMsg::ToggleAll)} />
                    {/if}
                {/if}
                {@include "../tracks/SelectionButtons.ui"}
                {#if self.views.view_mode == ViewMode::Grid}
                    <ToolbarButton icon="material-symbols:image-outline-rounded" label={t("album_view.covers")} title={t("album_view.covers_title")}
                                   pressed={self.views.artist_artwork} onclick={Msg::Artist(ArtistMsg::Covers)} />
                {:else}
                    <ToolbarButton icon="material-symbols:view-column-outline-rounded" label={t("album_view.columns")} title={t("tracks_view.columns")} onclick={Msg::Columns(ColumnsMsg::Open)} />
                {/if}
            </div>

            {#if !av.loading}
                <div class="flex justify-center py-10 text-(--rg-mu)"><Spinner width={22.} /></div>
            {:else if !av.has_tracks}
                <p class="m-0 py-10 text-center text-sm text-(--rg-mu)">{t("artist_view.no_tracks")}</p>
            {:else if !av.groups.is_empty()}
                {#if let Some(table) = &av.head}{@include "../tracks/TrackTableHead.ui"}{/if}
                {#each av.groups as g (g.key.as_str())}
                    {#if g.space == 7}
                        <div class="mt-7">{@include "ArtistGroupBlock.ui"}</div>
                    {:else if g.space == 1}
                        <div class="mt-1">{@include "ArtistGroupBlock.ui"}</div>
                    {:else}
                        <div class="mt-2">{@include "ArtistGroupBlock.ui"}</div>
                    {/if}
                {/each}
            {:else if self.views.view_mode == ViewMode::Grid}
                <div class="grid grid-cols-2 gap-x-7 @max-[900px]:grid-cols-1">
                    <div class="flex flex-col gap-y-0.5 min-w-0">
                        {#each av.flat_left as track (track.i)}{@include "../albums/AlbumTrackRow.ui"}{/each}
                    </div>
                    <div class="flex flex-col gap-y-0.5 min-w-0">
                        {#each av.flat_right as track (track.i)}{@include "../albums/AlbumTrackRow.ui"}{/each}
                    </div>
                </div>
            {:else}
                {#if let Some(table) = &av.table}
                    {@include "../tracks/TrackTableHead.ui"}
                    {@include "../tracks/TrackRows.ui"}
                {/if}
            {/if}
        </section>

        {#each av.participations.iter() as c (c.id)}
            {@include "../albums/AlbumCarousel.ui"}
        {/each}
        {#each av.similar.iter() as c (c.id)}
            {@include "ArtistCarousel.ui"}
        {/each}
    </div>
</div>
{/if}
{/if}
{/each}
</div>
