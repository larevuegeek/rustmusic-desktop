<div class="w-19 shrink-0 flex items-center">
    <div class="relative flex items-center" class:opacity-45={pl.1}>
        {#each pile_shown(&pl.0) as nm (nm.0)}
            {@const av = artist_avatar(ac, nm.1)}
            {#if nm.0 == 0}
                <div class="w-8 h-8 rounded-full overflow-hidden ring-[2.5px] ring-(--rg-creux)">
                    {#if let Some(ph) = &av.0}<img class="w-full h-full object-cover" src={cx.resources.cover(ph)} alt="">{/if}
                    {#if av.0.is_none()}<div class="avatar-artiste w-full h-full rounded-full flex items-center justify-center font-bold text-[12px]" style:--h={av.2}>{av.1.clone()}</div>{/if}
                </div>
            {:else}
                <div class="-ml-2.5 w-8 h-8 rounded-full overflow-hidden ring-[2.5px] ring-(--rg-creux)">
                    {#if let Some(ph) = &av.0}<img class="w-full h-full object-cover" src={cx.resources.cover(ph)} alt="">{/if}
                    {#if av.0.is_none()}<div class="avatar-artiste w-full h-full rounded-full flex items-center justify-center font-bold text-[12px]" style:--h={av.2}>{av.1.clone()}</div>{/if}
                </div>
            {/if}
        {/each}
        {#if let Some(more) = pile_more(&pl.0)}
            <div class="-ml-2.5 w-8 h-8 rounded-full ring-[2.5px] ring-(--rg-creux) bg-(--rg-s2) text-(--rg-tx2) flex items-center justify-center text-[11px] font-bold">{more}</div>
        {/if}
        {#if pl.2}
            <div class="absolute -right-1 -bottom-1 w-4.5 h-4.5 rounded-full bg-(--rg-g) text-white ring-2 ring-(--rg-gbg) flex items-center justify-center"><Icon icon="material-symbols:check-rounded" width={12} /></div>
        {/if}
    </div>
</div>
