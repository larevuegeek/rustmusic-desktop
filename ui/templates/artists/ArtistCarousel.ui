<section class="mt-12">
    <div class="flex flex-wrap items-end gap-3 mb-4">
        <div class="min-w-0">
            <h2 class="m-0 text-[22px] font-extrabold tracking-[-0.01em] text-(--rg-tx)">{c.title}</h2>
            {#if !c.subtitle.is_empty()}<div class="mt-1 text-[13px] text-(--rg-mu)">{c.subtitle}</div>{/if}
        </div>
        <div class="ml-auto flex items-center gap-3">
        {#if self.views.view_mode == ViewMode::Grid && (c.back || c.forward)}
            {@include "../shared/buttons/CarouselArrows.ui"}
        {/if}
        </div>
    </div>
    {#if self.views.view_mode == ViewMode::Grid}
        {#each [c.view] as view (view)}
        <div class="flex gap-4.5 pb-1 overflow-x-auto [scrollbar-width:none]"
             onscroll={{ let id = c.id; move |s: ScrollMetrics| Msg::CarouselScrolled(id, CarouselGeometry::of(s)) }}
             onscrollrange={{ let id = c.id; move |s: ScrollMetrics| Msg::CarouselScrolled(id, CarouselGeometry::of(s)) }}
             style:scroll_request={c.request}>
            {#each c.items as artist (artist.id.as_str())}
                <div class="shrink-0 w-[150px] @5xl:w-[165px] @6xl:w-[185px] @7xl:w-[200px]">{@include "ArtistCard.ui"}</div>
            {/each}
        </div>
        {/each}
    {:else}
        <div class="flex flex-col">
            {#each c.items as (i, artist) (artist.id.as_str())}{@include "ArtistRow.ui"}{/each}
        </div>
    {/if}
</section>
