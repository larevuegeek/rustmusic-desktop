<div class="flex flex-col min-h-0 max-h-[calc(88vh_-_69px)]">
    <div class="shrink-0 px-6 pt-5 pb-4 border-b border-(--rg-bd) bg-linear-180 from-(--rg-g)/6 to-transparent">
        <div class="flex items-center gap-3.5">
            {#if ac.running}
                <div class="relative w-11 h-11 shrink-0 rounded-full flex items-center justify-center bg-(--rg-gbg) text-(--rg-g)">
                    <div class="absolute inset-0 rounded-full border-[2.5px] border-(--rg-g)/20"></div>
                    <Icon icon="material-symbols:travel-explore-rounded" width={20} />
                </div>
            {:else}
                <div class="w-11 h-11 shrink-0 rounded-full border flex items-center justify-center bg-(--rg-gbg) border-(--rg-gbd) text-(--rg-g)"><Icon icon="material-symbols:check-circle-outline-rounded" width={22} /></div>
            {/if}
            <div class="flex-1 min-w-0">
                <p class="m-0 truncate text-[15px] font-bold text-(--rg-tx)">{ac.title()}</p>
                {@const st = ac.subtitle()}
                {#if st.1}<p class="m-0 mt-0.5 truncate text-[12.5px] text-(--rg-am)">{st.0.clone()}</p>{:else}<p class="m-0 mt-0.5 truncate text-[12.5px] text-(--rg-mu)">{st.0.clone()}</p>{/if}
            </div>
            {#if ac.running && ac.total > 1}
                <div class="shrink-0 flex items-baseline text-[28px] leading-none font-bold tabular-nums tracking-tight text-(--rg-g)"><div>{(ac.percent() as i64).to_string()}</div><div class="ml-0.5 text-[15px] font-semibold text-(--rg-gtx)">%</div></div>
            {/if}
        </div>
        {@const ct = ac.counts()}
        <div class="relative mt-4 h-2 rounded-full overflow-hidden bg-(--rg-s2)">
            {#if ac.running}
                <div class="h-full rounded-full bg-(--rg-g) transition-[width] duration-500" style:width={Length::Percent(ac.percent().max(2.))}></div>
            {:else if ct.0 + ct.1 + ct.2 > 0}
                <div class="flex h-full gap-0.5">
                    {#if ct.0 > 0}<div class="h-full rounded-full bg-(--rg-g)" style:flex_grow={ct.0 as f32}></div>{/if}
                    {#if ct.1 > 0}<div class="h-full rounded-full bg-(--rg-mu2)" style:flex_grow={ct.1 as f32}></div>{/if}
                    {#if ct.2 > 0}<div class="h-full rounded-full bg-(--rg-am)" style:flex_grow={ct.2 as f32}></div>{/if}
                </div>
            {/if}
        </div>
        <div class="mt-3.5 grid grid-cols-3 gap-2">
            {#each ac.count_tiles() as tl (tl.icon)}
                <div class="flex items-center gap-2.5 min-w-0 px-3 py-2.5 rounded-xl border border-(--rg-bd) bg-(--rg-creux)">
                    {#if tl.tone == 0}<div class="w-7 h-7 shrink-0 rounded-lg flex items-center justify-center bg-(--rg-gbg) text-(--rg-g)"><Icon icon={tl.icon} width={16} /></div>
                    {:else if tl.tone == 1}<div class="w-7 h-7 shrink-0 rounded-lg flex items-center justify-center bg-(--rg-s2) text-(--rg-tx2)"><Icon icon={tl.icon} width={16} /></div>
                    {:else}<div class="w-7 h-7 shrink-0 rounded-lg flex items-center justify-center bg-(--rg-ambg) text-(--rg-am)"><Icon icon={tl.icon} width={16} /></div>{/if}
                    <div class="flex-1 min-w-0">
                        <div class="text-[19px] leading-none font-bold tabular-nums text-(--rg-tx)">{tl.value}</div>
                        <div class="mt-1 truncate text-[11.5px] text-(--rg-mu)">{tl.label}</div>
                    </div>
                </div>
            {/each}
        </div>
    </div>

    <div class="min-h-0 overflow-y-auto scrollbar-app px-6 py-5">
        {#if let Some(er) = &ac.fault}
            <div class="flex items-start gap-2 px-4 py-3 mb-3 rounded-xl border border-red-500/25 bg-red-500/8 text-sm text-red-400">
                <div class="flex shrink-0 mt-px"><Icon icon="material-symbols:warning-outline-rounded" width={17} /></div><div class="min-w-0">{er}</div>
            </div>
        {/if}
        {#if ac.running}
            <div class="flex flex-col gap-2">
                <div class="relative overflow-hidden flex items-center gap-3.5 p-3 rounded-2xl border border-(--rg-gbd) bg-(--rg-creux)">
                    <div class="w-19 shrink-0 flex items-center"><div class="w-8 h-8 rounded-full flex items-center justify-center text-(--rg-g) border-[2.5px] border-(--rg-g)/20"><Icon icon="material-symbols:search-rounded" width={15} /></div></div>
                    <div class="relative min-w-0 flex-1">
                        <p class="m-0 text-[13px] font-semibold truncate text-(--rg-tx)">{ac.live_name()}</p>
                        <p class="m-0 mt-0.5 text-[12px] text-(--rg-gtx)">{t("artist_split.live_searching")}</p>
                    </div>
                </div>
                {#each ac.feed() as x (x.name.clone())}
                    {#if x.decision == "split"}
                        <div class="group flex flex-wrap items-center gap-x-3.5 gap-y-2.5 p-3 rounded-2xl border transition-colors border-(--rg-bd) bg-(--rg-creux)">
                            {@const pl = (x.parts.clone(), false, false)}{@include "ArtistCheckPile.ui"}
                            <div class="min-w-0 flex-1 basis-56">
                                <p class="m-0 text-[13px] font-semibold truncate text-(--rg-tx)" title={x.name.clone()}>{x.name.clone()}</p>
                                <div class="mt-1.5">{@const nm = (x.parts.clone(), false)}{@include "ArtistCheckNames.ui"}</div>
                            </div>
                            <div class="shrink-0 flex items-center gap-1 text-[12px] font-semibold text-(--rg-gtx)"><Icon icon="material-symbols:check-rounded" width={15} /><div>{t("artist_split.done_split")}</div></div>
                        </div>
                    {:else}
                        {@const v = ArtistRule { name: x.name.clone(), parts: x.parts.clone(), source: "musicbrainz".into() }}{@include "ArtistCheckDecide.ui"}
                    {/if}
                {/each}
                {#if ac.feed().is_empty()}<p class="m-0 pt-6 text-center text-[12.5px] text-(--rg-mu)">{t("artist_split.live_hint")}</p>{/if}
            </div>
        {:else}
            {#if let Some(rp) = &ac.report}
                {#if !rp.unknown.is_empty()}
                    <div class="flex items-center gap-2 mb-1">
                        <h3 class="m-0 text-[12px] font-bold uppercase tracking-[0.09em] text-(--rg-tx2)">{t("artist_split.section_unknown")}</h3>
                        <div class="px-1.75 py-0.5 rounded-md font-mono text-[11px] font-bold bg-(--rg-ambg) text-(--rg-am)">{ac.to_decide()}</div>
                    </div>
                    <p class="m-0 mb-3 text-[12.5px] text-(--rg-mu)">{t("artist_split.section_unknown_desc")}</p>
                    <div class="flex flex-col gap-2 mb-7">
                        {#each rp.unknown as v (v.name.clone())}{@include "ArtistCheckDecide.ui"}{/each}
                    </div>
                {/if}
                {#if !rp.split.is_empty()}
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="m-0 text-[12px] font-bold uppercase tracking-[0.09em] text-(--rg-tx2)">{t("artist_split.section_split")}</h3>
                        <div class="px-1.75 py-0.5 rounded-md font-mono text-[11px] font-bold bg-(--rg-gbg) text-(--rg-gtx)">{ac.remaining()}</div>
                        {#if ac.remaining() > 1}
                            <button class="ml-auto shrink-0 flex items-center gap-1.5 h-8 px-3 rounded-xl text-[12px] font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                                    onclick={Msg::ArtistCheck(ArtistCheckMsg::UndoAll)}><Icon icon="lucide:undo-2" width={14} /><div>{t("artist_split.undo_all")}</div></button>
                        {/if}
                    </div>
                    <div class="flex flex-col gap-2 mb-6">
                        {#each rp.split as v (v.name.clone())}
                            {@const cancelled = ac.undone.contains(&v.name)}
                            <div class="group flex flex-wrap items-center gap-x-3.5 gap-y-2.5 p-3 rounded-2xl border transition-colors border-(--rg-bd) bg-(--rg-creux) hover:border-(--rg-bd2)">
                                {@const pl = (if cancelled { vec![v.name.clone()] } else { v.parts.clone() }, cancelled, false)}{@include "ArtistCheckPile.ui"}
                                <div class="min-w-0 flex-1 basis-56">
                                    <div class="flex items-center gap-2 min-w-0">
                                        {#if cancelled}<div class="text-[13px] font-semibold truncate text-(--rg-mu)">{v.name.clone()}</div>{:else}<div class="text-[13px] font-semibold truncate text-(--rg-tx)">{v.name.clone()}</div>{/if}
                                        <div class="shrink-0 flex items-center gap-1 text-[11px] text-(--rg-mu)"><Icon icon={artist_source_icon(&v.source)} width={12} /><div>{artist_source(&v.source)}</div></div>
                                    </div>
                                    <div class="mt-1.5">
                                        {#if cancelled}<p class="m-0 text-[12px] text-(--rg-mu)">{t("artist_split.done_whole")}</p>{:else}{@const nm = (v.parts.clone(), false)}{@include "ArtistCheckNames.ui"}{/if}
                                    </div>
                                </div>
                                {#if cancelled}
                                    <button class="shrink-0 flex items-center gap-1.5 h-8 px-3 rounded-xl text-[12px] font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                                            onclick={Msg::ArtistCheck(ArtistCheckMsg::Redo(v.name.clone()))}><Icon icon="material-symbols:call-split-rounded" width={15} /><div>{t("artist_split.redo")}</div></button>
                                {:else}
                                    <button class="shrink-0 flex items-center gap-1.5 h-8 px-3 rounded-xl text-[12px] font-semibold cursor-pointer transition-colors opacity-70 group-hover:opacity-100 text-(--rg-tx2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                                            onclick={Msg::ArtistCheck(ArtistCheckMsg::Undo(v.name.clone()))}><Icon icon="lucide:undo-2" width={14} /><div>{t("artist_split.undo")}</div></button>
                                {/if}
                            </div>
                        {/each}
                    </div>
                {/if}
                {#if rp.split.is_empty() && rp.unknown.is_empty()}
                    <div class="flex flex-col items-center justify-center gap-3 py-12 text-center text-[13px] text-(--rg-mu)">
                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center bg-(--rg-gbg) border border-(--rg-gbd) text-(--rg-g)"><Icon icon="material-symbols:done-all-rounded" width={24} /></div>
                        <div>{t("artist_split.nothing")}</div>
                    </div>
                {/if}
                <div class="flex gap-2 px-1 text-xs text-(--rg-mu)">
                    <div class="flex shrink-0 mt-px text-(--rg-mu2)"><Icon icon="material-symbols:info-outline-rounded" width={15} /></div><div class="min-w-0">{t("artist_split.footnote")}</div>
                </div>
            {/if}
            {#if ac.report.is_none()}
                <div class="flex flex-col gap-2">{#each [0usize, 1, 2] as k (k)}<div class="h-16 rounded-2xl animate-pulse bg-(--rg-creux)"></div>{/each}</div>
            {/if}
        {/if}
    </div>

    {#if ac.running}
        <div class="shrink-0 flex items-center gap-3 px-6 py-3.5 border-t border-(--rg-bd) bg-(--rg-creux)">
            <div class="relative flex w-2 h-2 shrink-0"><div class="absolute inset-0 rounded-full bg-(--rg-g) animate-ping"></div><div class="relative w-2 h-2 rounded-full bg-(--rg-g)"></div></div>
            <div class="flex-1 min-w-0 truncate text-[12.5px] text-(--rg-mu)">{t("artist_split.background_hint")}</div>
            <button class="shrink-0 flex items-center gap-2 h-10 pl-3.5 pr-4 rounded-xl border border-(--rg-bd) bg-(--rg-champ) text-sm font-semibold text-(--rg-tx2) cursor-pointer transition-colors hover:border-(--rg-gbd) hover:bg-(--rg-gbg) hover:text-(--rg-gtx)"
                    onclick={Msg::ArtistCheck(ArtistCheckMsg::Close)}><Icon icon="material-symbols:close-fullscreen-rounded" width={16} /><div>{t("artist_split.hide")}</div></button>
        </div>
    {:else}
        <div class="shrink-0 flex items-center gap-3 px-6 py-3.5 border-t border-(--rg-bd) bg-(--rg-creux)">
            <div class="flex-1 min-w-0"></div>
            <button class="h-10 px-4 flex items-center rounded-xl text-sm font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-hover) hover:text-(--rg-tx)"
                    onclick={Msg::ArtistCheck(ArtistCheckMsg::Close)}><div>{t("batch.close")}</div></button>
        </div>
    {/if}
</div>
