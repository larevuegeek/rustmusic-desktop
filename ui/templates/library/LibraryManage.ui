{#if self.is_nested_manage(b.id)}
    <!-- Ce bouton a ouvert le menu « Gérer » par-dessus la liste : il en porte l'ancre. -->
    <button id="sidebar.library.manage.open"
            class="shrink-0 w-7 h-7 rounded-md flex items-center justify-center
                   cursor-pointer transition-colors
                   text-neutral-700 dark:text-neutral-200 bg-neutral-200/60 dark:bg-white/8"
            onclick={Msg::Library(LibraryMsg::Manage(b.id))} title={t("library_head.manage_title")} aria-label={t("library_head.manage_title")}
            aria-haspopup="menu" aria-expanded="true">
        <Icon icon="material-symbols:more-horiz" width={16} />
    </button>
{:else}
    <button class="shrink-0 w-7 h-7 rounded-md flex items-center justify-center
                   cursor-pointer transition-colors
                   text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-200/60 dark:hover:bg-white/8"
            onclick={Msg::Library(LibraryMsg::Manage(b.id))} title={t("library_head.manage_title")} aria-label={t("library_head.manage_title")}
            aria-haspopup="menu" aria-expanded="false">
        <Icon icon="material-symbols:more-horiz" width={16} />
    </button>
{/if}
