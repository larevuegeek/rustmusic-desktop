<div class="h-full overflow-y-auto scrollbar-app py-6 px-10">
    <div class="max-w-[1100px] mx-auto flex flex-col gap-6 pb-10" style:margin_top={-self.export_offset}>

        <div class="relative overflow-hidden rounded-[24px] p-12 text-(--rg-tx)">
            <div class="hero-vert absolute inset-0"></div>
            <div class="absolute -right-24 -top-24 w-[420px] h-[420px] text-(--rg-g) max-md:hidden">{@include "../shared/display/DiscWatermark.ui"}</div>
            <div class="relative flex flex-col gap-4 max-w-2xl">
                <div class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.08em] text-(--rg-gtx)">
                    <Icon icon="material-symbols:library-music-outline-rounded" width={18} />
                    {#if let Some(name) = &self.import_library_name()}
                        <div>{t("import_page.kicker_empty")}</div>
                        <div class="normal-case tracking-normal font-medium text-(--rg-tx2)">· {name}</div>
                    {/if}
                    {#if self.import_library_name().is_none()}<div>{t("import_page.kicker_new")}</div>{/if}
                </div>
                <h1 class="m-0 text-[48px] font-extrabold tracking-[-0.03em] leading-[1.05]">{t("import_page.title")}</h1>
                <p class="m-0 text-[16px] leading-relaxed text-(--rg-tx2) max-w-xl">{t("import_page.subtitle")}</p>
                {#if self.import_library_name().is_none()}
                    <div class="flex flex-col gap-1.5 mt-2 max-w-sm">
                        <div class="text-xs font-semibold text-(--rg-mu)">{t("import_page.name_label")}</div>
                        <input class="h-11 px-3.5 rounded-xl text-[15px] font-semibold outline-none transition-colors bg-(--rg-carte)/80 border border-(--rg-bd2) text-(--rg-tx) placeholder:text-(--rg-ph)"
                               type="text" value={self.views.import_name.as_str()} placeholder={t("import_page.name_default")} aria-label={t("import_page.name_label")}
                               oninput={|v: String| Msg::ImportName(v)}>
                    </div>
                {/if}
            </div>
        </div>

        <div class="grid grid-cols-[1.4fr_1fr] gap-4">
            <button class="rg-carte-import group relative overflow-hidden flex flex-col gap-4 p-7 rounded-[20px] text-left cursor-pointer bg-(--rg-g) text-(--rg-on-g)"
                    onclick={Msg::AddDirectory}>
                <div class="absolute top-5 right-5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-black/15">{t("import_page.recommended")}</div>
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-black/12"><Icon icon="material-symbols:create-new-folder-outline-rounded" width={30} /></div>
                <div class="flex flex-col gap-1.5">
                    <div class="text-[22px] font-extrabold tracking-[-0.015em]">{t("import_page.folder_title")}</div>
                    <div class="text-[14px] leading-relaxed opacity-80 max-w-md">{t("import_page.folder_desc")}</div>
                </div>
                <div class="absolute bottom-6 right-6 flex transition-transform group-hover:translate-x-1"><Icon icon="material-symbols:arrow-forward-rounded" width={26} /></div>
            </button>
            <button class="rg-carte-import group relative flex flex-col gap-4 p-7 rounded-[20px] text-left cursor-pointer bg-(--rg-carte) border border-(--rg-bd2) text-(--rg-tx) hover:border-(--rg-g)"
                    onclick={Msg::AddFiles}>
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-(--rg-gbg) text-(--rg-g)"><Icon icon="material-symbols:audio-file-outline-rounded" width={30} /></div>
                <div class="flex flex-col gap-1.5">
                    <div class="text-[22px] font-extrabold tracking-[-0.015em]">{t("import_page.files_title")}</div>
                    <div class="text-[14px] leading-relaxed text-(--rg-mu) max-w-sm">{t("import_page.files_desc")}</div>
                </div>
                <div class="absolute bottom-6 right-6 flex text-(--rg-mu) transition-transform group-hover:translate-x-1 group-hover:text-(--rg-g)"><Icon icon="material-symbols:arrow-forward-rounded" width={26} /></div>
            </button>
        </div>

        <div class="grid grid-cols-3 gap-3">
            {#each [("material-symbols:sell-outline-rounded", "import_page.feat_tags"), ("material-symbols:monitoring-rounded", "import_page.feat_live"), ("material-symbols:stop-circle-outline-rounded", "import_page.feat_stop")] as point (point.0)}
                <div class="flex items-center gap-3 p-4 rounded-2xl bg-(--rg-creux) border border-(--rg-line)">
                    <div class="w-9 h-9 shrink-0 rounded-xl flex items-center justify-center bg-(--rg-gbg) text-(--rg-g)"><Icon icon={point.0} width={20} /></div>
                    <div class="flex-1 min-w-0 text-[13.5px] leading-snug text-(--rg-tx2)">{t(point.1)}</div>
                </div>
            {/each}
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <div class="text-xs font-semibold uppercase tracking-[0.08em] text-(--rg-mu2) mr-1">{t("import_page.formats")}</div>
            {#each ["FLAC", "MP3", "M4A", "AAC", "OGG", "Opus", "WAV", "AIFF", "DSF", "DFF"] as f (f)}
                <div class="px-2 py-0.5 rounded-md font-mono text-[11px] font-semibold bg-(--rg-s2) text-(--rg-tx2)">{f}</div>
            {/each}
        </div>
    </div>
</div>
