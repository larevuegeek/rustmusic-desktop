{#if let Some(cs) = &self.views.cover_search}
<div class="absolute inset-0 z-[70] flex items-center justify-center p-6 animate-[popin-fade-in_150ms_linear]" data-exit="popin-fade-out 150ms linear">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm cursor-default" onclick={Msg::Cover(CoverMsg::Close)}></div>
    <div class="relative w-full max-w-2xl h-[75vh] flex flex-col overflow-hidden rounded-2xl text-(--rg-tx) bg-(--rg-carte) border border-(--rg-bd) dark:border-[#2a312d] shadow-[0_24px_60px_-12px_rgba(0,0,0,0.25)] dark:shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] animate-[popin-scale-in_180ms_cubic-bezier(0.33,1,0.68,1)]" data-exit="popin-scale-out 180ms cubic-bezier(0.33, 1, 0.68, 1)">
        <div class="rg-popin-tete shrink-0 px-6 pt-5 pb-4 border-b border-(--rg-bd)">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="shrink-0 w-8 h-8 rounded-[9px] flex items-center justify-center bg-(--rg-gbg) text-(--rg-g) border border-(--rg-gbd)"><Icon icon="lucide:disc-album" width={15} /></div>
                    <div class="min-w-0">
                        <h2 class="m-0 truncate text-[17px] font-extrabold tracking-[-0.01em] text-(--rg-tx)">{t("popins.cover_search_title")}</h2>
                        <p class="m-0 text-[11px] text-(--rg-mu)">{t("popins.cover_search_source")}</p>
                    </div>
                </div>
                <button class="shrink-0 -mr-1.5 w-8 h-8 rounded-[9px] flex items-center justify-center cursor-pointer text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-hover) transition-colors"
                        aria-label={t("common.close")} title={t("common.close")} onclick={Msg::Cover(CoverMsg::Close)}><Icon icon="lucide:x" width={15} /></button>
            </div>
        </div>

        <div class="shrink-0 flex items-center gap-2 px-6 py-4 border-b border-(--rg-bd) bg-(--rg-creux)">
            <div class="relative flex-1">
                <input class="w-full h-11 pl-10 pr-4 text-sm rounded-xl outline-none transition-colors bg-(--rg-champ) border border-(--rg-bd) text-(--rg-tx) placeholder:text-(--rg-ph) hover:border-(--rg-bd2)"
                       type="text" value={cs.query.as_str()} placeholder={t("popins.cover_search_placeholder")} aria-label={t("popins.cover_search_placeholder")}
                       oninput={|v: String| Msg::Cover(CoverMsg::Query(v))} onchange={Msg::Cover(CoverMsg::Search)}>
                <div class="absolute left-3.5 top-1/2 -translate-y-1/2 flex text-(--rg-mu)"><Icon icon="lucide:search" width={16} /></div>
            </div>
            <button class="h-11 min-w-24 px-4 rounded-xl border text-sm font-bold cursor-pointer flex items-center justify-center transition-colors border-(--rg-gbd) bg-(--rg-gbg) text-(--rg-gtx) hover:border-(--rg-g)"
                    onclick={Msg::Cover(CoverMsg::Search)}>
                {#if cs.loading}<div class="flex animate-spin"><Icon icon="lucide:loader-2" width={16} /></div>{:else}<div>{t("settings.shortcut_search")}</div>{/if}
            </button>
        </div>

        <div class="flex-1 min-h-0 overflow-y-auto scrollbar-app px-6 py-5">
            {#if cs.loading}
                <div class="flex items-center justify-center h-full">
                    <div class="flex flex-col items-center gap-3">
                        <div class="flex animate-spin text-(--rg-g)"><Icon icon="lucide:loader-2" width={24} /></div>
                        <p class="m-0 text-[13px] text-(--rg-mu)">{t("popins.searching")}</p>
                    </div>
                </div>
            {:else if cs.results.is_empty()}
                <div class="flex flex-col items-center justify-center h-full text-center">
                    <div class="w-16 h-16 rounded-2xl border border-(--rg-bd) bg-(--rg-creux) flex items-center justify-center mb-4 text-(--rg-mu2)"><Icon icon="lucide:disc-album" width={28} /></div>
                    <p class="m-0 text-sm font-semibold text-(--rg-tx2) mb-1">{t(if cs.query.trim().is_empty() { "popins.cover_search_empty" } else { "search.no_result" })}</p>
                    <p class="m-0 text-xs text-(--rg-mu)">{t(if cs.query.trim().is_empty() { "popins.cover_search_empty_hint" } else { "search.no_result_desc" })}</p>
                </div>
            {:else}
                <div class="grid grid-cols-4 gap-3">
                    {#each cs.results as (i, r) (i)}
                        {#if cs.selected == Some(i)}
                            <button class="group flex flex-col rounded-2xl overflow-hidden border text-left cursor-pointer transition-colors duration-200 border-(--rg-g) bg-(--rg-creux-on) shadow-[0_0_0_1px_rgba(34,197,94,1)]"
                                    onclick={Msg::Cover(CoverMsg::Select(i))}>
                                <div class="aspect-square relative overflow-hidden">
                                    {#if let Some(th) = &r.thumb}<img class="w-full h-full object-cover scale-105 transition-transform duration-300" src={cx.resources.cover(th)} alt={r.title.clone()}>{/if}
                                    <div class="absolute inset-0 bg-(--rg-g)/10 flex items-center justify-center">
                                        <div class="w-8 h-8 rounded-full bg-(--rg-g) text-(--rg-on-g) flex items-center justify-center shadow-lg"><Icon icon="material-symbols:check-rounded" width={18} /></div>
                                    </div>
                                    {#if cs.applying}<div class="absolute inset-0 bg-black/50 flex items-center justify-center"><div class="flex animate-spin text-white"><Icon icon="lucide:loader-2" width={20} /></div></div>{/if}
                                </div>
                                <div class="px-3 py-2.5 min-w-0">
                                    <p class="m-0 text-[12px] font-semibold truncate text-(--rg-gtx)">{r.title}</p>
                                    <p class="m-0 mt-0.5 text-[11px] text-(--rg-mu) truncate">{r.artist}</p>
                                </div>
                            </button>
                        {:else}
                            <button class="group flex flex-col rounded-2xl overflow-hidden border text-left cursor-pointer transition-colors duration-200 border-(--rg-bd) bg-(--rg-creux) hover:border-(--rg-bd2)"
                                    onclick={Msg::Cover(CoverMsg::Select(i))}>
                                <div class="aspect-square relative overflow-hidden">
                                    {#if let Some(th) = &r.thumb}<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={cx.resources.cover(th)} alt={r.title.clone()}>{/if}
                                </div>
                                <div class="px-3 py-2.5 min-w-0">
                                    <p class="m-0 text-[12px] font-semibold truncate text-(--rg-tx)">{r.title}</p>
                                    <p class="m-0 mt-0.5 text-[11px] text-(--rg-mu) truncate">{r.artist}</p>
                                </div>
                            </button>
                        {/if}
                    {/each}
                </div>
            {/if}
        </div>

        {#if let Some(sel) = &cs.selected.and_then(|i| cs.results.get(i))}
            <div class="shrink-0 flex items-center justify-between gap-3 px-6 py-3.5 border-t border-(--rg-bd) bg-(--rg-creux)">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden border border-(--rg-bd)">
                        {#if let Some(th) = &sel.thumb}<img class="w-full h-full object-cover" src={cx.resources.cover(th)} alt="">{/if}
                    </div>
                    <div class="min-w-0">
                        <p class="m-0 text-[13px] font-semibold text-(--rg-tx) truncate">{sel.title}</p>
                        <p class="m-0 text-[11px] text-(--rg-mu) truncate">{sel.artist}</p>
                    </div>
                </div>
                {#if cs.applying}
                    <div class="shrink-0 h-10 pl-4 pr-5 rounded-xl text-sm font-bold flex items-center gap-2 bg-(--rg-g) text-(--rg-on-g) opacity-40">
                        <div class="flex animate-spin"><Icon icon="lucide:loader-2" width={17} /></div><div>{t("popins.applying")}</div>
                    </div>
                {:else}
                    <button class="shrink-0 h-10 pl-4 pr-5 rounded-xl text-sm font-bold cursor-pointer flex items-center gap-2 bg-(--rg-g) text-(--rg-on-g) hover:brightness-110 transition"
                            onclick={Msg::Cover(CoverMsg::Apply)}>
                        <Icon icon="material-symbols:check-rounded" width={17} /><div>{t("popins.cover_apply")}</div>
                    </button>
                {/if}
            </div>
        {/if}
    </div>
</div>
{/if}
