<div class="h-full">
{#each self.views.album.iter() as page (page.id.as_str())}
{#if page.loading_state && page.album.is_none()}
    <div class="flex items-center justify-center h-full text-(--rg-mu)"><Spinner width={26.} /></div>
{:else if page.album.is_none()}
    <div class="flex flex-col items-center justify-center gap-3 h-full text-(--rg-mu)">
        <Icon icon="material-symbols:album-outline" width={34} />
        <p class="text-sm m-0">{t("album_view.error")}</p>
        <button class="text-sm font-semibold text-(--rg-gtx) hover:underline cursor-pointer" onclick={Msg::Go(Route::Library(Section::Albums))}><div>{t("album_view.back")}</div></button>
    </div>
{:else}
{#if let Some(av) = self.album_view()}
<div class="relative h-full overflow-y-auto scrollbar-app">
    <div class="album-lueur absolute inset-x-0 top-0 h-115 pointer-events-none" style:--h={av.tint.0} style:--s={av.tint.1}></div>

    <div class="@container relative max-w-350 px-4 md:px-8 pb-24" style:margin_top={-self.export_offset}>
        <div class="z-20 h-15 -mx-4 md:-mx-8 px-4 md:px-8 flex items-center gap-3 border-b border-transparent">
            <button class="h-8.5 pl-2 pr-3 shrink-0 flex items-center gap-1.5 rounded-[9px] text-sm font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                    onclick={Msg::Go(Route::Library(Section::Albums))}>
                <Icon icon="material-symbols:arrow-back-rounded" width={20} />
                <div>{t("album_view.back")}</div>
            </button>
            <div class="flex-1"></div>
            {@include "../tracks/SelectionButtons.ui"}
            <div class="flex shrink-0 p-0.75 rounded-[10px] border bg-(--rg-carte)/80 border-(--rg-bd)" role="radiogroup" aria-label={t("albums_view.grid_or_list")}>
                {#if self.views.view_mode == ViewMode::Grid}
                    <button role="radio" aria-checked="true" class="w-8 h-7 flex items-center justify-center rounded-[7px] cursor-pointer bg-(--rg-s2) text-(--rg-tx)" title={t("albums_view.grid")} onclick={Msg::Albums(AlbumsMsg::View(ViewMode::Grid))}><Icon icon="material-symbols:grid-view-outline-rounded" width={18} /></button>
                    <button role="radio" aria-checked="false" class="w-8 h-7 flex items-center justify-center rounded-[7px] cursor-pointer text-(--rg-mu) hover:text-(--rg-tx)" title={t("albums_view.list")} onclick={Msg::Albums(AlbumsMsg::View(ViewMode::List))}><Icon icon="material-symbols:view-list-outline-rounded" width={18} /></button>
                {:else}
                    <button role="radio" aria-checked="false" class="w-8 h-7 flex items-center justify-center rounded-[7px] cursor-pointer text-(--rg-mu) hover:text-(--rg-tx)" title={t("albums_view.grid")} onclick={Msg::Albums(AlbumsMsg::View(ViewMode::Grid))}><Icon icon="material-symbols:grid-view-outline-rounded" width={18} /></button>
                    <button role="radio" aria-checked="true" class="w-8 h-7 flex items-center justify-center rounded-[7px] cursor-pointer bg-(--rg-s2) text-(--rg-tx)" title={t("albums_view.list")} onclick={Msg::Albums(AlbumsMsg::View(ViewMode::List))}><Icon icon="material-symbols:view-list-outline-rounded" width={18} /></button>
                {/if}
            </div>
            <div class="flex gap-0.5">
                {#each [(av.prev.clone(), "material-symbols:chevron-left-rounded", "album_view.prev"), (av.next.clone(), "material-symbols:chevron-right-rounded", "album_view.next")] as o (o.2)}
                    {#if o.0.is_some()}
                        <button class="w-8 h-8 flex items-center justify-center rounded-lg cursor-pointer transition-colors text-(--rg-mu) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
                                title={t(o.2)} aria-label={t(o.2)} onclick={Msg::Go(o.0.clone().unwrap_or(Route::Home))}>
                            <Icon icon={o.1} width={22} />
                        </button>
                    {:else}
                        <div class="w-8 h-8 flex items-center justify-center rounded-lg text-(--rg-mu) opacity-30" title={t(o.2)}>
                            <Icon icon={o.1} width={22} />
                        </div>
                    {/if}
                {/each}
            </div>
        </div>

        <div class="relative flex flex-wrap items-end gap-8 pt-3 pb-7">
            <div class="relative w-58 aspect-square shrink-0 rounded-[14px] overflow-hidden shadow-[0_24px_60px_rgba(0,0,0,0.3)] dark:shadow-[0_24px_60px_rgba(0,0,0,0.55)]">
                {#if av.cover.is_some()}
                    <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&av.cover)} alt="">
                {:else}
                    <div class="w-full h-full flex items-center justify-center text-(--rg-mu2) shadow-[inset_0_0_0_1px_var(--rg-bd)] bg-(--rg-s2)">
                        <Icon icon="material-symbols:album-outline" width={64} />
                    </div>
                {/if}
                <div class="absolute inset-0 rounded-[14px] ring-1 ring-inset ring-black/5 dark:ring-white/6 pointer-events-none"></div>
            </div>

            <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-3">
                <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold tracking-widest uppercase text-(--rg-tx2)">
                    <div>{av.type_label}</div>
                    {#if let Some(q) = &av.quality}<QualityBadge tier={q.0} text={q.1.clone()} />{/if}
                </div>

                {#if av.title_long}
                    <h1 class="m-0 font-extrabold leading-[1.12] tracking-[-0.03em] line-clamp-3 text-(--rg-tx) text-[44px]" title={av.title.as_str()}>{av.title}</h1>
                {:else}
                    <h1 class="m-0 font-extrabold leading-[1.12] tracking-[-0.03em] line-clamp-3 text-(--rg-tx) text-[56px]" title={av.title.as_str()}>{av.title}</h1>
                {/if}

                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px] text-(--rg-mu)">
                    {#if av.artist_route.is_some()}
                        <button class="flex items-center gap-2 min-w-0 font-bold text-(--rg-tx) hover:underline underline-offset-2 cursor-pointer"
                                onclick={Msg::Go(av.artist_route.clone().unwrap_or(Route::Home))}>
                            <div class="w-6.5 h-6.5 shrink-0 rounded-full overflow-hidden flex items-center justify-center bg-(--rg-s2) text-(--rg-mu)">
                                {#if av.artist_portrait.is_some()}
                                    <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&av.artist_portrait)} alt="">
                                {:else}
                                    <Icon icon="material-symbols:person-rounded" width={16} />
                                {/if}
                            </div>
                            <div class="truncate">{av.artist}</div>
                        </button>
                    {:else}
                        <div class="font-bold text-(--rg-tx)">{av.artist}</div>
                    {/if}
                    {#if let Some(y) = &av.year}
                        <div class="text-(--rg-mu2)">·</div>
                        <button class="hover:text-(--rg-tx) hover:underline underline-offset-2 cursor-pointer" title={t_with("album_view.year_title", &[("y", &y.to_string())])}
                                onclick={Msg::Go(Route::Library(Section::Albums))}><div>{y}</div></button>
                    {/if}
                    <div class="text-(--rg-mu2)">·</div>
                    <div>{av.tracks_count}</div>
                    {#if !av.duration.is_empty()}<div class="text-(--rg-mu2)">·</div><div>{av.duration}</div>{/if}
                    {#if !av.weight.is_empty()}<div class="text-(--rg-mu2)">·</div><div>{av.weight}</div>{/if}
                </div>

                <div class="flex flex-wrap items-center gap-2.5 mt-2">
                    <PlayButton large label={t("album_view.play")} onclick={Msg::Album(AlbumMsg::PlayAll)} />
                    <RoundButton icon="material-symbols:shuffle-rounded" title={t("album_view.shuffle")} onclick={Msg::Album(AlbumMsg::Shuffle)} />
                    {#if av.liked_all}
                        <RoundButton icon="material-symbols:favorite-rounded" pressed title={t("album_view.fav_remove")} onclick={Msg::Album(AlbumMsg::LikeAll)} />
                    {:else}
                        <RoundButton icon="material-symbols:favorite-outline-rounded" title={t("album_view.fav_add")} onclick={Msg::Album(AlbumMsg::LikeAll)} />
                    {/if}
                    <RoundButton icon="material-symbols:more-horiz" title={t("album_view.more")} anchor={DETAIL_MORE.to_string()}
                                 onclick={Msg::CollOpen(TrackMenuAt::Named(DETAIL_MORE.into()), av.title.clone(), CollectionSource::Album { id: page.id.clone(), artist: Some(av.artist.clone()) })} />
                    {#if !av.genres.is_empty()}
                        <div class="flex flex-wrap gap-1.5 ml-1.5">
                            {#each av.genres as g (g.as_str())}
                                <ChipLink label={g.clone()} title={t("album_view.genre_title")} onclick={Msg::Go(Route::Genre(g.clone()))} />
                            {/each}
                        </div>
                    {/if}
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 pt-1 pb-3.5">
            <div class="mr-auto flex gap-1 text-[13px] text-(--rg-mu)">
                <div class="font-semibold text-(--rg-tx2)">{av.count_n}</div>
                <div>{av.count_label}</div>
                {#if !av.duration.is_empty()}<div>· {av.duration}</div>{/if}
            </div>
            {#if av.multi}
                <div class="flex shrink-0 p-0.75 rounded-[10px] border bg-(--rg-carte) border-(--rg-bd)" role="radiogroup" aria-label={t("common.sort")}>
                    {#each av.sorts as s (s.key)}
                        {#if s.active}
                            <button role="radio" aria-checked="true" class="flex items-center justify-center gap-1 rounded-[7px] text-[13px] font-semibold cursor-pointer whitespace-nowrap h-7 px-3 bg-(--rg-s2) text-(--rg-tx)"
                                    onclick={Msg::Album(AlbumMsg::Sort(s.key.to_string()))}>
                                <div>{s.label}</div>
                                {#if let Some(a) = &s.arrow}<Icon icon={*a} width={14} />{/if}
                            </button>
                        {:else}
                            <button role="radio" aria-checked="false" class="flex items-center justify-center gap-1 rounded-[7px] text-[13px] font-semibold cursor-pointer whitespace-nowrap h-7 px-3 text-(--rg-mu) hover:text-(--rg-tx)"
                                    onclick={Msg::Album(AlbumMsg::Sort(s.key.to_string()))}>
                                <div>{s.label}</div>
                            </button>
                        {/if}
                    {/each}
                </div>
            {/if}
            {#if self.views.view_mode == ViewMode::Grid}
                <ToolbarButton icon="material-symbols:image-outline-rounded" label={t("album_view.covers")} title={t("album_view.covers_title")}
                               pressed={!self.views.without_artwork} onclick={Msg::Album(AlbumMsg::Covers)} />
            {:else}
                <ToolbarButton icon="material-symbols:view-column-outline-rounded" label={t("album_view.columns")} title={t("tracks_view.columns")} onclick={Msg::Columns(ColumnsMsg::Open)} />
            {/if}
        </div>

        {#if av.discs.is_empty() && av.table.is_none()}
            <p class="py-10 text-center text-sm text-(--rg-mu) m-0">{t("album_view.no_tracks")}</p>
        {:else if self.views.view_mode == ViewMode::Grid}
            {#each av.discs as (di, d) (d.n)}
                {#if d.n > 0}
                    {#if di == 0}
                        <div class="flex items-center gap-2 pb-2 px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--rg-mu2)">
                            <Icon icon="material-symbols:album-outline" width={16} /><div>{d.label}</div>
                        </div>
                    {:else}
                        <div class="flex items-center gap-2 pt-4 pb-2 px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--rg-mu2)">
                            <Icon icon="material-symbols:album-outline" width={16} /><div>{d.label}</div>
                        </div>
                    {/if}
                {/if}
                <div class="grid grid-cols-2 gap-x-7 @max-[900px]:grid-cols-1">
                    <div class="flex flex-col gap-y-0.5 min-w-0">
                        {#each d.left as track (track.i)}{@include "AlbumTrackRow.ui"}{/each}
                    </div>
                    <div class="flex flex-col gap-y-0.5 min-w-0">
                        {#each d.right as track (track.i)}{@include "AlbumTrackRow.ui"}{/each}
                    </div>
                </div>
            {/each}
        {:else}
            {#if let Some(table) = &av.table}
                {@include "../tracks/TrackTable.ui"}
            {/if}
        {/if}

        {#if av.output.is_some() || av.label.is_some() || av.folder.is_some()}
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-5 px-3 text-[13px] text-(--rg-mu)">
                {#if let Some(s) = &av.output}<div>{s}</div>{/if}
                {#if let Some(l) = &av.label}
                    <div class="flex gap-1"><div>{t("album_view.label")}</div><div class="font-semibold text-(--rg-tx2)">{l}</div></div>
                {/if}
                {#if let Some(d) = &av.folder}<PathChip path={d.clone()} reveal={av.reveal.clone()} />{/if}
            </div>
        {/if}

        {#if let Some(notes) = &av.notes}
            <section class="mt-12">
                <h2 class="m-0 mb-2 text-[22px] font-extrabold tracking-[-0.01em] text-(--rg-tx)">{t("album_view.about")}</h2>
                <p class="m-0 max-w-3xl text-sm leading-relaxed text-(--rg-mu)">{notes}</p>
            </section>
        {/if}

        {#each av.others.iter() as c (c.id)}
            {@include "AlbumCarousel.ui"}
        {/each}
        {#each av.similar.iter() as c (c.id)}
            {@include "AlbumCarousel.ui"}
        {/each}
        {#each av.artists.iter() as c (c.id)}
            {@include "../artists/ArtistCarousel.ui"}
        {/each}
    </div>
</div>
{/if}
{/if}
{/each}
</div>
