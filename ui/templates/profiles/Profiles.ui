{#if let Some(ps) = &self.views.profiles}
<div class="absolute inset-0 z-[60] bg-[#f6f4ef]/97 dark:bg-black/95 backdrop-blur-sm">
    <button class="absolute top-6 right-6 z-[200] w-11 h-11 rounded-full flex items-center justify-center bg-(--rg-carte) dark:bg-white/10 backdrop-blur-md border border-(--rg-bd) dark:border-white/10 text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2) dark:hover:bg-white/20 transition-all duration-200 cursor-pointer"
            aria-label={t("common.close")} onclick={Msg::Profiles(ProfileMsg::Close)}>
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>

    <div class="absolute inset-0 overflow-y-auto scrollbar-none">
    <div class="min-h-full flex items-center justify-center py-10">
    {#if ps.mode == ProfileMode::Select}
        <div class="flex flex-col items-center gap-12">
            <div class="flex flex-col items-center gap-3 text-center">
                <h2 class="m-0 text-4xl font-bold text-(--rg-tx) tracking-tight">{t("profil.who_listens")}</h2>
                <p class="m-0 text-sm text-(--rg-mu) max-w-md">{t("profil.select_desc")}</p>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-10">
                {#each self.profile_list() as p (p.id)}
                    <div class="group relative w-32 flex flex-col items-center gap-4">
                        {#if self.is_current_profile(p.id)}
                            <button class="relative cursor-pointer transition-all duration-300 ease-out rounded-2xl overflow-hidden scale-110 ring-[3px] ring-(--rg-g) shadow-[0_0_40px_rgba(34,197,94,0.25)]"
                                    aria-label={p.name.clone()} onclick={Msg::Profiles(ProfileMsg::Select(p.id))}>
                                <div class="flex">{@include "ProfileAvatar.ui"}</div>
                            </button>
                        {:else}
                            <button class="relative cursor-pointer transition-all duration-300 ease-out rounded-2xl overflow-hidden hover:scale-108 hover:shadow-2xl ring-[3px] ring-transparent hover:ring-black/10 dark:hover:ring-white/20"
                                    aria-label={p.name.clone()} onclick={Msg::Profiles(ProfileMsg::Select(p.id))}>
                                <div class="flex">{@include "ProfileAvatar.ui"}</div>
                            </button>
                        {/if}
                        <div class="flex flex-col items-center gap-1.5">
                            <div class="text-sm font-medium text-(--rg-tx2) group-hover:text-(--rg-tx) transition-colors duration-200 text-center truncate w-32">{p.name}</div>
                            {#if profile_is_admin(p)}
                                <div class="flex justify-center"><div class="flex items-center px-1.5 py-px text-[10px] gap-1 rounded-full font-medium bg-amber-500/15 text-amber-400">{t("profil.admin_badge")}</div></div>
                            {/if}
                        </div>
                        <div class="flex justify-center">
                        <button class="flex items-center gap-1.5 px-3 py-1 rounded-full cursor-pointer text-[11px] font-medium text-(--rg-mu2) hover:text-(--rg-tx2) hover:bg-(--rg-s2) dark:hover:bg-white/5 transition-all duration-200"
                                onclick={Msg::Profiles(ProfileMsg::Edit(p.id))}>
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
                            <div>{t("profil.modify_hover")}</div>
                        </button>
                        </div>
                    </div>
                {/each}
                <div class="w-32 flex flex-col items-center gap-4">
                    <button class="w-32 h-32 rounded-2xl cursor-pointer border-[3px] border-(--rg-bd2) dark:border-white/12 hover:border-(--rg-mu2) dark:hover:border-white/25 hover:bg-(--rg-s2) dark:hover:bg-white/5 flex items-center justify-center transition-all duration-300 ease-out hover:scale-105 text-(--rg-mu2)"
                            aria-label={t("profil.add_profil")} onclick={Msg::Profiles(ProfileMsg::Create)}>
                        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    </button>
                    <div class="text-sm font-medium text-(--rg-mu) text-center">{t("profil.add")}</div>
                </div>
            </div>
        </div>
    {:else}
        {@include "ProfileForm.ui"}
    {/if}
    </div>
    </div>
</div>
{/if}
