<button class="group w-full flex flex-col gap-2.5 min-w-0 text-left cursor-pointer" title={entry.name.as_str()} onclick={entry.open.clone()}>
    <div class="relative w-full aspect-square">
        {#if let Some(checked) = entry.checked}<div class="absolute left-2 top-2 z-10">{@include "../tracks/TrackSelectionCheck.ui"}</div>{/if}
        <div class="relative w-full h-full rounded-xl overflow-hidden border border-(--rg-bd) group-hover:border-(--rg-bd2) transition-colors duration-200 shadow-[0_6px_18px_-8px_rgb(0_0_0/0.45)]">
            {#if entry.cover.is_some()}
                <img class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src={cx.resources.cover_opt(&entry.cover)} alt="">
                <div class="absolute left-2 bottom-2 h-6 px-1.5 flex items-center rounded-md bg-black/60 text-white text-[10px] font-bold uppercase tracking-[0.06em]">{entry.format}</div>
            {:else}
                <div class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(ellipse_farthest-corner_at_50%_50%,var(--rg-gbg)_10%,var(--rg-carte)_75%)]">
                    <div class="w-[54%] aspect-square transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105">{@include "FileArt.ui"}</div>
                </div>
            {/if}
            <div class="absolute right-2 bottom-2 w-9 h-9 flex items-center justify-center rounded-full bg-(--rg-g) text-(--rg-on-g) shadow-lg opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition duration-200">
                <Icon icon="material-symbols:play-arrow-rounded" width={22} />
            </div>
        </div>
    </div>
    <div class="w-full min-w-0 px-0.5">
        <div class="line-clamp-2 text-sm font-semibold leading-5 text-(--rg-tx)">{entry.title}</div>
        <div class="mt-1 truncate text-[12px] text-(--rg-mu)">{entry.infos}</div>
    </div>
</button>
