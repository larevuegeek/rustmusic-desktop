{#if self.views.view_mode == ViewMode::List}
    <div class="flex flex-col pt-2">
        {#each fv.roots as (i, dir) (dir.id.as_str())}
            <button class="group relative w-full grid grid-cols-[48px_minmax(0,1fr)_100px_90px_150px_40px] max-[900px]:grid-cols-[48px_minmax(0,1fr)_90px_40px] items-center gap-4 py-2 pl-2 pr-3 rounded-xl text-left cursor-pointer transition-colors hover:bg-(--rg-carte)"
                    onclick={Msg::Folders(FoldersMsg::Open(dir.path.clone(), dir.name.clone()))}>
                {#if i > 0}<div class="absolute left-18 right-3 top-0 h-px bg-(--rg-line) group-hover:opacity-0"></div>{/if}
                <div class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center border bg-(--rg-ambg) border-(--rg-ambd)">
                    <div class="w-[78%] h-[78%]">{@const music = true}{@include "FolderArt.ui"}</div>
                </div>
                <div class="min-w-0">
                    <div class="truncate text-base font-semibold text-(--rg-tx)">{dir.name}</div>
                    <div class="mt-0.5 truncate font-mono text-xs text-(--rg-mu)" title={dir.path.as_str()}>{dir.path}</div>
                </div>
                <div class="flex justify-end gap-1 text-[13px] tabular-nums text-(--rg-mu)"><div class="font-medium text-(--rg-tx2)">{dir.files_n}</div><div>{dir.files_label}</div></div>
                <div class="text-right text-[13px] tabular-nums text-(--rg-mu) max-[900px]:hidden">{dir.size}</div>
                <div class="flex justify-end max-[900px]:hidden">{@include "RootState.ui"}</div>
                <div class="justify-self-end text-(--rg-mu2) group-hover:text-(--rg-tx2)"><Icon icon="material-symbols:chevron-right-rounded" width={19} /></div>
            </button>
        {/each}
    </div>
{:else}
    <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-4 pt-3">
        {#each fv.roots as dir (dir.id.as_str())}
            <button class="group w-full flex flex-col gap-3.5 p-4 rounded-2xl border text-left cursor-pointer transition-colors bg-(--rg-carte) border-(--rg-bd) hover:border-(--rg-bd2)"
                    onclick={Msg::Folders(FoldersMsg::Open(dir.path.clone(), dir.name.clone()))}>
                <div class="w-full flex items-start justify-between gap-3">
                    <div class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center border bg-(--rg-ambg) border-(--rg-ambd)">
                        <div class="w-[78%] h-[78%]">{@const music = true}{@include "FolderArt.ui"}</div>
                    </div>
                    {@include "RootState.ui"}
                </div>
                <div class="w-full min-w-0">
                    <div class="truncate text-[15px] font-bold text-(--rg-tx)" title={dir.name.as_str()}>{dir.name}</div>
                    <div class="mt-0.5 truncate font-mono text-[11px] text-(--rg-mu)" title={dir.path.as_str()}>{dir.path}</div>
                </div>
                <div class="w-full flex items-center gap-1.5 text-[13px] text-(--rg-mu) whitespace-nowrap">
                    <div class="font-semibold text-(--rg-tx2)">{dir.files_n}</div><div>{dir.files_label}</div>
                    {#if !dir.size.is_empty()}<div>· {dir.size}</div>{/if}
                    {#if !dir.when.is_empty()}<div class="ml-auto font-mono text-[11px] text-(--rg-mu2)">{dir.when}</div>{/if}
                </div>
            </button>
        {/each}
    </div>
{/if}
