<div class="biblio-maquette flex flex-col h-full relative">
    {@include "../library/LibraryHeader.ui"}
    <div class="flex-1 min-h-0 overflow-hidden">
    {#if let Some(fv) = self.folders_view()}
    {#each self.views.folders.iter() as page (page.library_id)}
    <div class="flex flex-col h-full">
        <div class="@container shrink-0 pl-4 md:pl-8 pr-4 md:pr-14 pt-3 pb-2">
            <div class="flex flex-wrap @3xl:flex-nowrap items-center gap-2">
                <SearchField class="flex-1 min-w-40 max-w-72" value={page.search.clone()} placeholder={fv.placeholder.clone()} clear_label={t("folders_view.clear")} field={Field::PageSearch} />
                {#if !fv.is_root && fv.has_files}
                    <button class="h-8.5 px-3 flex items-center gap-1.5 rounded-[10px] border text-[13px] font-semibold whitespace-nowrap cursor-pointer transition-colors bg-(--rg-carte) border-(--rg-bd) text-(--rg-tx2) hover:border-(--rg-bd2) hover:text-(--rg-tx) shrink-0"
                            title={t("folders_view.play_folder")} onclick={Msg::Folders(FoldersMsg::PlayFolder)}>
                        <div class="text-(--rg-g)"><Icon icon="material-symbols:play-arrow-rounded" width={18} /></div><div class="@max-5xl:hidden">{t("folders_view.play_folder")}</div>
                    </button>
                    <button class="h-8.5 px-3 flex items-center gap-1.5 rounded-[10px] border text-[13px] font-semibold whitespace-nowrap cursor-pointer transition-colors bg-(--rg-carte) border-(--rg-bd) text-(--rg-tx2) hover:border-(--rg-bd2) hover:text-(--rg-tx) shrink-0"
                            title={t("workshop.fix_tags")} onclick={Msg::Folders(FoldersMsg::EditTags)}>
                        <Icon icon="material-symbols:table-edit-outline-rounded" width={18} /><div class="@max-5xl:hidden">{t("workshop.fix_tags")}</div>
                    </button>
                {/if}
                <div class="flex-1 min-w-0"></div>
                <div class="shrink-0 flex items-center gap-2">
                    <MenuSelect anchor="folders.sort" open={self.popup("folders.sort")} label={fv.sort_label.clone()} icon={fv.sort_icon} options={fv.sorts.clone()} />
                    {#if !fv.is_root && !page.entries.is_empty()}
                        {#if page.without_covers}
                            <ToolbarButton icon="material-symbols:photo-library-outline-rounded" label={t("folders_view.covers")} title={t("folders_view.covers_hint")} onclick={Msg::Folders(FoldersMsg::Covers)} />
                        {:else}
                            <ToolbarButton icon="material-symbols:photo-library-rounded" pressed label={t("folders_view.covers")} title={t("folders_view.covers_hint")} onclick={Msg::Folders(FoldersMsg::Covers)} />
                        {/if}
                    {/if}
                    <SegmentedControl subtle label={t("albums_view.grid_or_list")} options={fv.views.clone()} />
                    <ToolbarButton icon="material-symbols:select-check-box-rounded" label={t("albums_view.select")} title={t("albums_view.select")} pressed={self.selecting()} onclick={Msg::Selection(SelectionMsg::Toggle)} />
                </div>
            </div>

            {#if !fv.is_root}
                <div class="mt-3 flex items-center gap-3 min-w-0">
                    <div class="flex items-center min-w-0 h-10 pl-1 pr-1.5 rounded-xl border border-(--rg-bd) bg-(--rg-carte) text-[13px]" aria-label={t("nav.folders")}>
                        <button class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg cursor-pointer text-(--rg-mu) hover:bg-(--rg-s2) hover:text-(--rg-tx) transition-colors"
                                title={t("common.parent_folder")} aria-label={t("common.parent_folder")} onclick={Msg::Folders(FoldersMsg::Parent)}>
                            <Icon icon="material-symbols:arrow-upward-rounded" width={18} />
                        </button>
                        <div class="w-px h-5 mx-1 shrink-0 bg-(--rg-bd)"></div>
                        <button class="shrink-0 h-8 flex items-center gap-1.5 px-2 rounded-lg cursor-pointer text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2) transition-colors"
                                onclick={Msg::Folders(FoldersMsg::Root)}>
                            <Icon icon="material-symbols:hard-drive-outline-rounded" width={16} /><div class="@max-xl:hidden">{t("folders_view.root")}</div>
                        </button>
                        {#each fv.crumbs as c (c.path.as_str())}
                            <div class="shrink-0 text-(--rg-mu2)"><Icon icon="material-symbols:chevron-right-rounded" width={16} /></div>
                            {#if c.cache.is_some()}
                                <button class="flex items-center justify-center shrink-0 h-8 px-2 rounded-lg cursor-pointer text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2)"
                                        title={c.cache_title()} onclick={Msg::Folders(FoldersMsg::Open(c.path.clone(), String::new()))}><div>…</div></button>
                            {:else if !c.last}
                                <button class="flex items-center justify-center min-w-0 max-w-44 h-8 px-2 rounded-lg cursor-pointer text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2) transition-colors"
                                        title={c.path.as_str()} onclick={Msg::Folders(FoldersMsg::Open(c.path.clone(), c.name.clone()))}><div class="truncate">{c.name}</div></button>
                            {:else}
                                <div class="min-w-0 h-8 flex items-center gap-1.5 pl-1.5 pr-2.5 rounded-lg bg-(--rg-s2) font-semibold text-(--rg-tx)" title={c.path.as_str()} aria-current="page">
                                    <div class="w-5 h-5 shrink-0">{@const music = fv.music_here}{@include "FolderArt.ui"}</div>
                                    <div class="truncate">{c.name}</div>
                                </div>
                            {/if}
                        {/each}
                    </div>
                    <div class="ml-auto shrink-0 flex items-center gap-1.5 text-xs text-(--rg-mu)">
                        {#if let Some(n) = &fv.dir_count}
                            <div class="h-7 flex items-center gap-1.5 px-2.5 rounded-lg border border-(--rg-bd) bg-(--rg-carte)">
                                <div class="text-(--rg-am)"><Icon icon="material-symbols:folder-rounded" width={14} /></div><div>{n}</div>
                            </div>
                        {/if}
                        {#if let Some(n) = &fv.file_count}
                            <div class="h-7 flex items-center gap-1.5 px-2.5 rounded-lg border border-(--rg-bd) bg-(--rg-carte)">
                                <div class="text-(--rg-g)"><Icon icon="material-symbols:music-note-rounded" width={14} /></div><div>{n}</div>
                            </div>
                        {/if}
                    </div>
                </div>
            {/if}
        </div>

        <div class="flex-1 relative min-h-0">
            {#each [page.window.view] as view (view)}
            <div class="absolute inset-0 overflow-y-auto scrollbar-app pl-4 md:pl-8 pr-4 md:pr-14 pb-16"
                 onscroll={|s: ScrollMetrics| Msg::Folders(FoldersMsg::Scrolled(s.offset, s.max_offset()))}>
                {#if page.loading}
                    <div class="flex items-center justify-center py-20 text-(--rg-mu)"><Spinner width={26.} /></div>
                {:else if fv.is_root && self.no_library_dirs()}
                    <div class="flex flex-col items-center justify-center py-20 text-center">
                        <div class="w-16 h-16 mb-5 rounded-2xl border flex items-center justify-center bg-(--rg-gbg) border-(--rg-gbd) text-(--rg-g)">
                            <Icon icon="material-symbols:folder-open-outline-rounded" width={30} />
                        </div>
                        <h3 class="text-base font-semibold text-(--rg-tx) mb-1.5">{t("common.no_imported_folder")}</h3>
                        <p class="text-sm text-(--rg-mu) max-w-xs">{t("common.no_imported_folder_desc")}</p>
                    </div>
                {:else if fv.no_match}
                    <p class="m-0 py-16 text-center text-sm text-(--rg-mu)">{t("folders_view.no_match")}</p>
                {:else if fv.is_root}
                    {@include "Roots.ui"}
                {:else if fv.empty_folder}
                    <div class="flex flex-col items-center justify-center py-20 text-center text-(--rg-mu)">
                        <div class="mb-3"><Icon icon="material-symbols:folder-off-outline-rounded" width={32} /></div>
                        <p class="m-0 text-sm">{t("common.empty_folder")}</p>
                    </div>
                {:else}
                    {#if self.views.view_mode == ViewMode::Grid}
                        {#if !fv.dirs.is_empty()}
                            <div class="grid grid-cols-[repeat(auto-fill,minmax(168px,1fr))] gap-x-4 gap-y-5 pt-4">
                                {#each fv.dirs as entry (entry.path.as_str())}<div class="min-w-0" memo={crate::mapper::folders::folder_list::entry_key(entry, cx.resources, true)}>{@include "DirTile.ui"}</div>{/each}
                            </div>
                        {/if}
                        {#if !fv.files.is_empty()}
                            {#if fv.dirs.is_empty()}
                                <div class="grid grid-cols-[repeat(auto-fill,minmax(168px,1fr))] gap-x-4 gap-y-5 pt-4">
                                    {#each fv.files as entry (entry.path.as_str())}<div class="min-w-0" memo={crate::mapper::folders::folder_list::entry_key(entry, cx.resources, true)}>{@include "FileTile.ui"}</div>{/each}
                                </div>
                            {:else}
                                <div class="grid grid-cols-[repeat(auto-fill,minmax(168px,1fr))] gap-x-4 gap-y-5 pt-7">
                                    {#each fv.files as entry (entry.path.as_str())}<div class="min-w-0" memo={crate::mapper::folders::folder_list::entry_key(entry, cx.resources, true)}>{@include "FileTile.ui"}</div>{/each}
                                </div>
                            {/if}
                        {/if}
                    {:else}
                        <div class="flex flex-col pt-2">
                            {#each fv.dirs.iter().chain(fv.files.iter()) as (i, entry) (entry.path.as_str())}<div class="flex flex-col" memo={(i, crate::mapper::folders::folder_list::entry_key(entry, cx.resources, false))}>{@include "EntryRow.ui"}</div>{/each}
                        </div>
                    {/if}
                {/if}
            </div>
            {/each}
        </div>
    </div>
    {/each}
    {/if}
    </div>
</div>
