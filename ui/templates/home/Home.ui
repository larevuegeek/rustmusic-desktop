<div class="home-maquette h-full overflow-y-auto overscroll-contain scrollbar-app">
    <div class="@container max-w-[1480px] mx-auto flex flex-col gap-10 py-6 px-4 md:px-10 pb-16" style:margin_top={-self.export_offset}>

        <div class="-mb-4">
            {@include "HomeHeader.ui"}
        </div>

        {@const loading = vm.home_loading || self.export_skeleton}
        {#if loading}
            {@include "HomeSkeletonTop.ui"}
        {:else if vm.home_empty}
            <section class="flex flex-col gap-3 p-6 rounded-[20px] border border-white/10 bg-[#121614]">
                <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">{t("home_welcome.page_title")}</h2>
                <div class="text-[15px] text-neutral-500 dark:text-[#9aa39e]">{t("home_welcome.page_desc")}</div>
            </section>
        {:else}
            {@include "HomeResume.ui"}
            {@include "HomeMixes.ui"}
        {/if}

        {@include "HomePlaylists.ui"}

        {#if loading}
            {@include "HomeSkeletonBottom.ui"}
        {:else if !vm.home_empty}
            {@include "HomeGenres.ui"}
            {@include "HomeRecentlyAdded.ui"}
        {/if}

        {#if vm.show_recent}
            {@include "HomeRecents.ui"}
        {/if}
    </div>
</div>
