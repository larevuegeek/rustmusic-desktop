{#if !vm.recently_added.is_empty()}
<section class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">{t("home.recently_added")}</h2>
        <button class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer mt-[9.5px]"
                onclick={Msg::Go(Route::Library(Section::Albums))}><div>{t("home.see_all")}</div></button>
    </div>

    <div class="grid grid-cols-3 @3xl:grid-cols-4 @4xl:grid-cols-6 gap-[18px]">
        {#each vm.recently_added as album (album.id.as_str())}
            <button class="group w-full min-w-0 overflow-hidden flex flex-col gap-2 text-left cursor-pointer"
                    onclick={Msg::Go(Route::Album(album.id.clone()))} title={album.title.as_str()}>
                <div class="aspect-square rounded-[10px] overflow-hidden bg-neutral-200 dark:bg-neutral-800
                            border border-neutral-200 dark:border-[#1f2522]">
                    <div class="w-full h-full transition-transform duration-300 group-hover:scale-105">
                        <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&album.cover_path)} alt={album.title.as_str()}>
                    </div>
                </div>
                <div class="block text-[15px] font-semibold truncate text-neutral-900 dark:text-neutral-100">{album.title}</div>
                <div class="block text-[13px] -mt-1.5 truncate text-neutral-500 dark:text-[#9aa39e]">{album.subtitle}</div>
            </button>
        {/each}
    </div>
</section>
{/if}
