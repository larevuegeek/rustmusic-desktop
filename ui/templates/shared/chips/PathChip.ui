<div class="h-7.5 max-w-full min-w-0 pl-1 pr-1.5 flex items-center gap-1 rounded-lg border bg-(--rg-carte) border-(--rg-bd)">
    <button class="w-6 h-6 shrink-0 flex items-center justify-center rounded-md cursor-pointer transition-colors text-(--rg-mu2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
            title={t("album_view.open_folder")} aria-label={t("album_view.open_folder")} onclick={Msg::Reveal(self.reveal.clone())}>
        <Icon icon="material-symbols:folder-outline-rounded" width={16} />
    </button>
    <div class="font-mono text-xs truncate min-w-0 text-(--rg-tx2)" title={self.path.as_str()}>{self.path}</div>
    <button class="w-6 h-6 shrink-0 flex items-center justify-center rounded-md cursor-pointer transition-colors text-(--rg-mu2) hover:bg-(--rg-s2) hover:text-(--rg-tx)"
            title={t("album_view.copy_path")} aria-label={t("album_view.copy_path")} onclick={Msg::Noop}>
        <Icon icon="material-symbols:content-copy-outline-rounded" width={15} />
    </button>
</div>
