<div class="flex flex-col items-center gap-3 py-16 text-center text-(--rg-mu)">
    <Icon icon="material-symbols:search-off-rounded" width={32} />
    <p class="text-sm m-0">{self.message}</p>
    {#if let Some(msg) = &self.onclear}
        <button class="text-sm font-semibold cursor-pointer text-(--rg-gtx) hover:underline" onclick={msg.clone()}><div>{self.clear_label}</div></button>
    {/if}
</div>
