<div class="rg-field h-9.5 flex items-center gap-2 px-3 rounded-[10px] border bg-(--rg-carte) border-(--rg-bd) hover:border-(--rg-bd2) cursor-text">
    <div class="flex shrink-0 text-(--rg-mu)"><Icon icon="material-symbols:search-rounded" width={18} /></div>
    <input class="flex-1 min-w-0 bg-transparent border-0 outline-0 text-sm text-(--rg-tx) placeholder:text-(--rg-ph) h-[34px] p-0"
           type="text" value={self.value.as_str()} oninput={move |v: String| Msg::Input(field, v)}
           placeholder={self.placeholder.as_str()} aria-label={self.placeholder.as_str()}>
    {#if !self.value.is_empty()}
        <button class="flex shrink-0 text-(--rg-mu) hover:text-(--rg-tx) cursor-pointer"
                aria-label={self.clear_label.as_str()} title={self.clear_label.as_str()}
                onclick={Msg::Input(field, String::new())}>
            <Icon icon="material-symbols:close-rounded" width={16} />
        </button>
    {/if}
</div>
