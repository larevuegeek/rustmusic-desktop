<button class="h-8.5 px-2 flex items-center gap-1 text-[13px] font-semibold cursor-pointer text-(--rg-mu) hover:text-(--rg-tx)"
        title={self.label.as_str()} onclick={onclick}>
    <Icon icon={self.icon.as_str()} width={17} />
    <div class="w-auto whitespace-nowrap">{self.label}</div>
</button>
