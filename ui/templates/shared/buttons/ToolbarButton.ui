<div class="flex shrink-0">
{#if self.pressed && !self.label.is_empty()}
    <button class="shrink-0 flex items-center justify-center gap-1.5 rounded-[10px] border text-[13px] font-semibold whitespace-nowrap cursor-pointer transition-colors
                   h-8.5 pl-2.5 pr-3 bg-(--rg-gbg) border-(--rg-gbd) text-(--rg-gtx)"
            aria-pressed="true" title={self.title.as_str()} onclick={onclick}>
        <Icon icon={self.icon.as_str()} width={18} />
        <div class="w-auto">{self.label}</div>
    </button>
{:else if !self.label.is_empty()}
    <button class="shrink-0 flex items-center justify-center gap-1.5 rounded-[10px] border text-[13px] font-semibold whitespace-nowrap cursor-pointer transition-colors
                   h-8.5 pl-2.5 pr-3 bg-(--rg-carte) border-(--rg-bd) text-(--rg-tx2) hover:border-(--rg-bd2) hover:text-(--rg-tx)"
            title={self.title.as_str()} onclick={onclick}>
        <Icon icon={self.icon.as_str()} width={18} />
        <div class="w-auto">{self.label}</div>
    </button>
{:else if self.pressed}
    <button class="shrink-0 flex items-center justify-center rounded-[10px] border cursor-pointer transition-colors
                   w-9 h-9 bg-(--rg-gbg) border-(--rg-gbd) text-(--rg-gtx)"
            aria-pressed="true" title={self.title.as_str()} aria-label={self.title.as_str()} onclick={onclick}>
        <Icon icon={self.icon.as_str()} width={20} />
    </button>
{:else}
    <button class="shrink-0 flex items-center justify-center rounded-[10px] border cursor-pointer transition-colors
                   w-9 h-9 bg-(--rg-carte) border-(--rg-bd) text-(--rg-tx2) hover:border-(--rg-bd2) hover:text-(--rg-tx)"
            title={self.title.as_str()} aria-label={self.title.as_str()} onclick={onclick}>
        <Icon icon={self.icon.as_str()} width={20} />
    </button>
{/if}
</div>
