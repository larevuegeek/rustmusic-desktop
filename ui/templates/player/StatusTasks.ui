{#if let Some(p) = &vm.import}
    <div class="flex items-center gap-2.5 min-w-0">
        <div class="h-3 w-px shrink-0 bg-neutral-300/50 dark:bg-neutral-700/40" aria-hidden="true"></div>
        <div class="group/task min-w-0 flex items-center gap-2 pl-2 pr-2.5 py-1 rounded-lg bg-emerald-500/8 dark:bg-emerald-400/8 ring-1 ring-emerald-500/15 dark:ring-emerald-400/10">
            <div class="relative shrink-0 flex items-center justify-center w-4 h-4">
                <div class="absolute inset-0 rounded-full bg-emerald-500/15 dark:bg-emerald-400/15 animate-pulse" aria-hidden="true"></div>
                <div class="relative flex text-emerald-600 dark:text-emerald-400"><Icon icon={p.icon} width={12} /></div>
            </div>
            <div class="min-w-0 flex items-center gap-1.5">
                <div class="min-w-0 truncate text-[10px] font-medium whitespace-nowrap text-emerald-700 dark:text-emerald-300">{p.task}</div>
                {#if !p.listing && p.percent > 0.}
                    <div class="shrink-0 text-[10px] font-semibold tabular-nums text-emerald-600/80 dark:text-emerald-400/70">{p.percent_label}%</div>
                    <div class="shrink-0 w-16 h-1.5 rounded-full bg-neutral-200/70 dark:bg-white/8 overflow-hidden">
                        <div class="h-full rounded-full transition-[width] duration-500 ease-out bg-linear-to-r from-emerald-500 to-emerald-400 dark:from-emerald-400 dark:to-emerald-300" style:width={Length::Percent(p.percent)}></div>
                    </div>
                {/if}
                {#if !p.detail.is_empty()}
                    <div class="min-w-0 shrink-[999] text-[9px] text-neutral-400 dark:text-neutral-500 truncate max-w-24">{p.detail}</div>
                {/if}
            </div>
            {#if !p.stopping}
                <button class="shrink-0 flex opacity-0 group-hover/task:opacity-100 transition-opacity duration-200 p-0.5 rounded hover:bg-red-500/15 text-neutral-400 hover:text-red-500 dark:text-neutral-500 dark:hover:text-red-400 cursor-pointer"
                        onclick={Msg::StopScan} title={t("common.cancel")} aria-label={t("common.cancel")}>
                    <Icon icon="lucide:x" width={10} />
                </button>
            {/if}
        </div>
    </div>
{/if}
