<div class="w-screen h-screen flex items-center gap-3.5 px-3.5 bg-[#0f1211] text-white border border-white/[0.07] font-sans text-[16px]">
    <div class="relative w-[84px] h-[84px] shrink-0 rounded-xl overflow-hidden bg-white/[0.06] shadow-[0_8px_22px_rgba(0,0,0,0.45)]">
        {#if s.cover.is_some()}
            <img class="w-full h-full object-cover" src={cx.resources.cover_opt(&s.cover)} alt="">
        {:else}
            <div class="w-full h-full flex items-center justify-center text-white/30">
                <Icon icon="material-symbols:music-note-rounded" width={30} />
            </div>
        {/if}
    </div>
    <div class="flex-1 min-w-0 flex flex-col gap-2">
        <div class="flex items-start gap-2">
            <div class="flex-1 min-w-0 leading-[1.25]">
                {#if s.has_track}
                    <div class="text-[14px] font-semibold truncate" title={s.title.as_str()}>{s.title}</div>
                    <div class="text-[12px] text-white/55 truncate">{s.artist}</div>
                {:else}
                    <div class="text-[14px] font-semibold text-white/70 truncate">{t("tray.nothing")}</div>
                    <div class="text-[12px] text-white/40 truncate">RustMusic</div>
                {/if}
            </div>
            <button class="w-7 h-7 -mt-0.5 -mr-1 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition duration-150 text-white/45 hover:text-white hover:bg-white/10 active:scale-[0.94]"
                    title={t("tray.show")} aria-label={t("tray.show")} onclick={TrayMsg::Open}>
                <Icon icon="material-symbols:open-in-full-rounded" width={15} />
            </button>
        </div>
        <div class="flex items-center gap-1.5">
            <button class="w-8 h-8 flex items-center justify-center rounded-full cursor-pointer transition duration-150 text-white/75 hover:text-white hover:bg-white/10 active:scale-[0.94]"
                    title={t("common.previous")} aria-label={t("common.previous")} onclick={TrayMsg::Previous}>
                <Icon icon="material-symbols:skip-previous-rounded" width={22} />
            </button>
            <button class="w-10 h-10 flex items-center justify-center rounded-full cursor-pointer transition duration-150 bg-[#22c55e] text-[#04150a] hover:bg-[#34d673] active:scale-[0.94] shadow-[0_4px_14px_rgba(34,197,94,0.35)]"
                    title={t("tray.play_pause")} aria-label={t("tray.play_pause")} onclick={TrayMsg::TogglePlay}>
                {#if s.playing}
                    <Icon icon="material-symbols:pause-rounded" width={24} />
                {:else}
                    <Icon icon="material-symbols:play-arrow-rounded" width={24} />
                {/if}
            </button>
            <button class="w-8 h-8 flex items-center justify-center rounded-full cursor-pointer transition duration-150 text-white/75 hover:text-white hover:bg-white/10 active:scale-[0.94]"
                    title={t("common.next")} aria-label={t("common.next")} onclick={TrayMsg::Next}>
                <Icon icon="material-symbols:skip-next-rounded" width={22} />
            </button>
        </div>
        <div class="relative h-[3px] rounded-full bg-white/10" style:--p={s.progress}>
            <div class="absolute inset-y-0 left-0 rounded-full bg-[#22c55e] w-[calc(100%*var(--p,0))]"></div>
        </div>
    </div>
</div>
