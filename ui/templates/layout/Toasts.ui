{#if !self.views.toasts.list.is_empty()}
    <div class="absolute top-4 right-4 z-50 flex w-96 flex-col gap-3">
        {#each self.views.toasts.list as toast (toast.id)}
            {#if toast.variant() == "success"}
                <div class="relative overflow-hidden rounded-xl border shadow-lg backdrop-blur-xl text-neutral-900 dark:text-neutral-100 bg-emerald-500/10 border-emerald-500/25">{@include "ToastBody.ui"}</div>
            {:else if toast.variant() == "error"}
                <div class="relative overflow-hidden rounded-xl border shadow-lg backdrop-blur-xl text-neutral-900 dark:text-neutral-100 bg-rose-500/10 border-rose-500/25">{@include "ToastBody.ui"}</div>
            {:else if toast.variant() == "warning"}
                <div class="relative overflow-hidden rounded-xl border shadow-lg backdrop-blur-xl text-neutral-900 dark:text-neutral-100 bg-amber-500/10 border-amber-500/25">{@include "ToastBody.ui"}</div>
            {:else}
                <div class="relative overflow-hidden rounded-xl border shadow-lg backdrop-blur-xl text-neutral-900 dark:text-neutral-100 bg-sky-500/10 border-sky-500/25">{@include "ToastBody.ui"}</div>
            {/if}
        {/each}
    </div>
{/if}
