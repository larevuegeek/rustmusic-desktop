{#if self.controls == "macos"}
    <!-- Feux de macOS : rouge, jaune, vert, dans l'ordre du système. Le mini-lecteur reste
         côté intérieur. -->
    <div class="flex items-center gap-2 px-4 h-full">
        {#if !self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
        <button id="window.close" class="w-3 h-3 rounded-full flex items-center justify-center cursor-pointer
                       bg-[#ff5f57] shadow-[inset_0_0_0_0.5px_#e0443e] text-[#4d0000]"
                onclick={Msg::Close} aria-label={t("common.close")} title={t("common.close")}>
            <Icon icon="lucide:x" width={8} />
        </button>
        <button class="w-3 h-3 rounded-full flex items-center justify-center cursor-pointer
                       bg-[#febc2e] shadow-[inset_0_0_0_0.5px_#dea123] text-[#985700]"
                onclick={Msg::Minimize} aria-label={t("window.minimize")} title={t("window.minimize")}>
            <Icon icon="lucide:minus" width={8} />
        </button>
        <button class="w-3 h-3 rounded-full flex items-center justify-center cursor-pointer
                       bg-[#28c840] shadow-[inset_0_0_0_0.5px_#1aab29] text-[#006500]"
                onclick={Msg::Maximize} aria-label={t("window.maximize")} title={t("window.maximize")}>
            <Icon icon="lucide:maximize-2" width={7} />
        </button>
        {#if self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
    </div>
{:else if self.controls == "linux"}
    <!-- Boutons ronds d'Adwaita (GNOME). -->
    <div class="flex items-center gap-1.5 px-3 h-full">
        {#if !self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
        <button class="flex items-center justify-center w-6 h-6 rounded-full cursor-pointer
                       bg-neutral-200 dark:bg-white/10 text-neutral-700 dark:text-neutral-300
                       hover:bg-neutral-300 dark:hover:bg-white/20 transition-colors"
                onclick={Msg::Minimize} aria-label={t("window.minimize")}>
            <div class="w-2 h-px bg-current" aria-hidden="true"></div>
        </button>
        <button class="flex items-center justify-center w-6 h-6 rounded-full cursor-pointer
                       bg-neutral-200 dark:bg-white/10 text-neutral-700 dark:text-neutral-300
                       hover:bg-neutral-300 dark:hover:bg-white/20 transition-colors"
                onclick={Msg::Maximize} aria-label={t("window.maximize")}>
            <div class="w-[7px] h-[7px] border border-current" aria-hidden="true"></div>
        </button>
        <button id="window.close" class="flex items-center justify-center w-6 h-6 rounded-full cursor-pointer
                       bg-neutral-200 dark:bg-white/10 text-[#5e625d] dark:text-neutral-300
                       hover:bg-red-500 hover:text-white transition-colors"
                onclick={Msg::Close} aria-label={t("common.close")}>
            <div class="w-[7px] h-[7px] relative" aria-hidden="true">
                <div class="absolute -left-px top-[3px] w-[9px] h-px bg-current rotate-45"></div>
                <div class="absolute -left-px top-[3px] w-[9px] h-px bg-current -rotate-45"></div>
            </div>
        </button>
        {#if self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
    </div>
{:else}
    <!-- Boutons rectangulaires de Windows. -->
    <div class="flex items-center h-full">
        {#if !self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
        <button class="flex items-center justify-center w-11 h-full cursor-pointer
                       text-[#5e625d] dark:text-neutral-300
                       hover:bg-[#e5e1d8] dark:hover:bg-white/8
                       transition-colors"
                onclick={Msg::Minimize} aria-label={t("window.minimize")}>
            <div class="w-2 h-px bg-current" aria-hidden="true"></div>
        </button>
        <button class="flex items-center justify-center w-11 h-full cursor-pointer
                       text-[#5e625d] dark:text-neutral-300
                       hover:bg-[#e5e1d8] dark:hover:bg-white/8
                       transition-colors"
                onclick={Msg::Maximize} aria-label={t("window.maximize")}>
            <div class="w-[7.3px] h-[7.3px] border border-current" aria-hidden="true"></div>
        </button>
        <button id="window.close"
                class="flex items-center justify-center w-11 h-full cursor-pointer
                       text-[#5e625d] dark:text-neutral-300
                       hover:bg-red-500 hover:text-white
                       transition-colors"
                onclick={Msg::Close} aria-label={t("common.close")}>
            <div class="w-[7px] h-[7px] relative" aria-hidden="true">
                <div class="absolute -left-px top-[3px] w-[9px] h-px bg-current rotate-45"></div>
                <div class="absolute -left-px top-[3px] w-[9px] h-px bg-current -rotate-45"></div>
            </div>
        </button>
        {#if self.controls_left}
            {@include "MiniPlayerButton.ui"}
        {/if}
    </div>
{/if}
