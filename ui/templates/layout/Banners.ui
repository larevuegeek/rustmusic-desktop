{#if self.views.banners.update != Update::Idle}
    <div class="absolute bottom-38 right-4 z-50 max-w-sm w-[calc(100%-2rem)] rounded-xl shadow-2xl border backdrop-blur-xl bg-white/95 text-neutral-900 border-black/10 dark:bg-neutral-900/90 dark:text-neutral-100 dark:border-white/10 p-4">
        {@const up = &self.views.banners.update}
        {#if let Update::Available(version) = up}
            <div class="flex items-start gap-3">
                <div class="shrink-0 mt-0.5 flex items-center justify-center w-9 h-9 rounded-lg bg-green-500/15 border border-green-500/25 text-green-600 dark:text-green-400"><Icon icon="lucide:sparkles" width={18} /></div>
                <div class="flex-1 min-w-0">
                    <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white">{t_with("updater.available_title", &[("version", version)])}</p>
                    <p class="m-0 text-xs text-neutral-600 dark:text-neutral-400 mt-0.5">{t("updater.available_desc")}</p>
                    <div class="flex items-center gap-2 mt-3">
                        <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-green-600 hover:bg-green-500 text-white text-xs font-medium transition-colors cursor-pointer"
                                onclick={Msg::Banner(BannerMsg::UpdateInstall)}><Icon icon="lucide:download" width={13} /><div>{t("updater.install_now")}</div></button>
                        <button class="px-3 py-1.5 rounded-lg text-xs text-neutral-600 hover:text-neutral-900 hover:bg-black/5 dark:text-neutral-400 dark:hover:text-white dark:hover:bg-white/5 transition-colors cursor-pointer"
                                onclick={Msg::Banner(BannerMsg::UpdateLater)}><div>{t("updater.later")}</div></button>
                    </div>
                </div>
            </div>
        {:else if let Update::Downloading(version, ..) = up}
            <div class="flex items-start gap-3">
                <div class="shrink-0 mt-0.5 flex animate-spin text-green-600 dark:text-green-400"><Icon icon="lucide:loader-circle" width={18} /></div>
                <div class="flex-1 min-w-0">
                    <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white">{t_with("updater.downloading_title", &[("version", version)])}</p>
                    <p class="m-0 text-xs text-neutral-600 dark:text-neutral-400 mt-0.5 font-mono">{up.progress().0}</p>
                    <div class="mt-2 h-1 rounded-full bg-black/10 dark:bg-white/10 overflow-hidden">
                        <div class="h-full bg-linear-to-r from-green-500 to-emerald-400 transition-all duration-200" style:width={Length::Percent(up.progress().1 * 100.)}></div>
                    </div>
                </div>
            </div>
        {:else if *up == Update::Installing}
            <div class="flex items-center gap-3">
                <div class="flex animate-spin text-green-600 dark:text-green-400"><Icon icon="lucide:loader-circle" width={18} /></div>
                <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white flex-1">{t("updater.installing")}</p>
            </div>
        {:else if let Update::Ready(version) = up}
            <div class="flex items-center gap-3">
                <div class="flex text-green-600 dark:text-green-400"><Icon icon="lucide:check-circle-2" width={18} /></div>
                <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white flex-1">{t_with("updater.ready_restart", &[("version", version)])}</p>
            </div>
        {:else}
            <div class="flex items-start gap-3">
                <div class="shrink-0 mt-0.5 flex text-rose-600 dark:text-rose-400"><Icon icon="lucide:alert-triangle" width={18} /></div>
                <div class="flex-1 min-w-0">
                    <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white">{t("updater.error_title")}</p>
                    <p class="m-0 text-xs text-neutral-600 dark:text-neutral-400 mt-0.5">{up.error_text()}</p>
                    <div class="flex">
                        <button class="mt-2 px-3 py-1.5 rounded-lg text-xs text-neutral-600 hover:text-neutral-900 hover:bg-black/5 dark:text-neutral-400 dark:hover:text-white dark:hover:bg-white/5 transition-colors cursor-pointer"
                                onclick={Msg::Banner(BannerMsg::UpdateLater)}><div>{t("updater.dismiss")}</div></button>
                    </div>
                </div>
            </div>
        {/if}
    </div>
{/if}
{#if self.support_visible()}
    <div class="absolute bottom-38 right-4 z-50 max-w-sm w-[calc(100%-2rem)] rounded-xl shadow-2xl border backdrop-blur-xl bg-white/95 text-neutral-900 border-black/10 dark:bg-neutral-900/90 dark:text-neutral-100 dark:border-white/10 p-4">
        <div class="flex items-start gap-3">
            <div class="shrink-0 mt-0.5 flex items-center justify-center w-9 h-9 rounded-lg bg-amber-500/15 border border-amber-500/25 text-amber-600 dark:text-amber-400"><Icon icon="lucide:heart" width={18} /></div>
            <div class="flex-1 min-w-0">
                <p class="m-0 text-sm font-semibold text-neutral-900 dark:text-white">{t_with("support.prompt_title", &[("version", WN_VERSION)])}</p>
                <p class="m-0 text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">{t("support.prompt_text")}</p>
                <div class="flex flex-wrap items-center gap-2 mt-3">
                    <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-semibold transition-colors cursor-pointer"
                            onclick={Msg::Banner(BannerMsg::SupportOpen)}><Icon icon="lucide:heart-handshake" width={14} /><div>{t("support.prompt_cta")}</div></button>
                    <button class="px-3 py-1.5 rounded-lg text-xs font-medium text-neutral-700 hover:text-neutral-900 hover:bg-black/5 dark:text-neutral-300 dark:hover:text-white dark:hover:bg-white/8 transition-colors cursor-pointer"
                            onclick={Msg::Banner(BannerMsg::SupportLater)}><div>{t("support.prompt_later")}</div></button>
                </div>
                <div class="flex">
                    <button class="mt-2 text-[11px] text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-300 underline underline-offset-2 transition-colors cursor-pointer"
                            onclick={Msg::Banner(BannerMsg::SupportNever)}><div>{t("support.prompt_never")}</div></button>
                </div>
            </div>
            <button class="shrink-0 p-1 rounded-md text-neutral-500 hover:text-neutral-900 hover:bg-black/5 dark:hover:text-white dark:hover:bg-white/8 transition-colors cursor-pointer"
                    aria-label={t("support.prompt_later")} onclick={Msg::Banner(BannerMsg::SupportLater)}><Icon icon="lucide:x" width={14} /></button>
        </div>
    </div>
{/if}
