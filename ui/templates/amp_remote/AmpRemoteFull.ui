<div class="flex items-center gap-2.5 pl-0.5">
    {#if r.on}
        <div class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-[11px] border bg-(--rg-g)/10 border-(--rg-g)/25 text-(--rg-g)">
            <Icon icon="material-symbols:speaker-outline-rounded" width={22} />
        </div>
    {:else}
        <div class="w-9.5 h-9.5 shrink-0 flex items-center justify-center rounded-[11px] border bg-(--rg-s2) border-(--rg-bd) text-(--rg-mu)">
            <Icon icon="material-symbols:speaker-outline-rounded" width={22} />
        </div>
    {/if}
    <div class="flex-1 min-w-0 leading-[1.25]">
        <div class="text-[15px] font-semibold tracking-[-0.01em] truncate">{r.name}</div>
        {#if r.connected}
            <div class="flex items-center gap-1.5 text-[12px] text-(--rg-mu)">
                {#if r.on}
                    <div class="w-1.5 h-1.5 shrink-0 rounded-full bg-(--rg-g)"></div>
                {:else}
                    <div class="w-1.5 h-1.5 shrink-0 rounded-full bg-(--rg-off)"></div>
                {/if}
                <div class="min-w-0 truncate">{r.status}</div>
            </div>
        {:else}
            <div class="flex items-center gap-1.5 text-[12px] text-(--rg-am)">
                <div class="w-1.5 h-1.5 shrink-0 rounded-full bg-(--rg-am)"></div>
                <div class="min-w-0 truncate">{r.status}</div>
            </div>
        {/if}
    </div>
    <button class="w-9 h-9 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition duration-150 text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2) active:scale-[0.96]"
            title={t("amp_remote.mini")} aria-label={t("amp_remote.mini")} onclick={Msg::AmpRemote(AmpRemoteMsg::Mini)}>
        <Icon icon="material-symbols:close-fullscreen-rounded" width={19} />
    </button>
    <button class="w-9 h-9 shrink-0 flex items-center justify-center rounded-full cursor-pointer transition duration-150 text-(--rg-mu) hover:text-(--rg-tx) hover:bg-(--rg-s2) active:scale-[0.96]"
            title={t("amp_remote.settings")} aria-label={t("amp_remote.settings")} onclick={Msg::AmpRemote(AmpRemoteMsg::Settings)}>
        <Icon icon="material-symbols:settings-outline-rounded" width={20} />
    </button>
    <div class="w-10 h-10 shrink-0 flex">{@include "AmpPower.ui"}</div>
</div>

{#if r.hint}
    <div class="-mt-1 flex justify-end">
        <div class="px-2.5 py-1.5 rounded-lg bg-(--rg-s2) border border-(--rg-bd) text-[11.5px] text-(--rg-tx)">{t("amp_remote.hold_power")}</div>
    </div>
{/if}

{#if !r.connected}
    <p class="m-0 px-3.5 py-3 rounded-[14px] bg-(--rg-am)/10 text-[12px] leading-snug text-(--rg-am)">{r.unreachable}</p>
{:else if !r.on}
    <button class="h-52 flex flex-col justify-center gap-3 rounded-[18px] border border-(--rg-bd2) bg-(--rg-s2)/40 cursor-pointer text-(--rg-mu) hover:text-(--rg-tx) transition duration-150 active:scale-[0.96]"
            onclick={Msg::AmpRemote(AmpRemoteMsg::Send(Command::Power { zone: Zone::Main, on: true }))}>
        <div class="flex justify-center">
            <div class="w-18 h-18 flex items-center justify-center rounded-full bg-(--rg-s2) border border-(--rg-bd) text-(--rg-g)">
                <Icon icon="material-symbols:power-settings-new-rounded" width={34} />
            </div>
        </div>
        <div class="text-center text-[14px] font-medium text-(--rg-tx)">{t("amp_remote.standby")}</div>
        <div class="text-center text-[12.5px]">{t("amp_remote.tap_power_on")}</div>
    </button>
{:else}
    <div class="rounded-[18px] border border-(--rg-bd) bg-(--rg-s2)/50 p-2 pb-2.5 flex flex-col gap-2">
        <div class="amp-vfd relative rounded-xl overflow-hidden px-3 pt-2.25 pb-2.5" onwheel={wheel_volume()}>
            <div class="amp-dot flex justify-between gap-1 text-[9.5px] leading-none tracking-[0.06em]">
                {#each r.lights as light (light.0)}
                    {#if light.1}
                        <div class="text-[#8cf7d4]">{light.0}</div>
                    {:else}
                        <div class="text-[#11261f]">{light.0}</div>
                    {/if}
                {/each}
            </div>
            <div class="mt-2 flex items-end justify-between gap-2.5">
                {#if r.code_size >= 28.}
                    <div class="amp-dot min-w-0 pb-0.5 leading-none tracking-[0.08em] truncate text-[28px] text-[#8cf7d4]">{r.code}</div>
                {:else if r.code_size >= 21.}
                    <div class="amp-dot min-w-0 pb-0.5 leading-none tracking-[0.08em] truncate text-[21px] text-[#8cf7d4]">{r.code}</div>
                {:else}
                    <div class="amp-dot min-w-0 pb-0.5 leading-none tracking-[0.08em] truncate text-[16px] text-[#8cf7d4]">{r.code}</div>
                {/if}
                <div class="shrink-0 flex items-end gap-1.5">
                    {#each r.digits as (i, d) (i)}
                        <div class="relative w-[26px] h-[46px]">{@include "AmpDigit.ui"}</div>
                        {#if d.dot}<div class="amp-seg-off w-[5px] h-[5px] rounded-full" class:amp-seg-lit={r.lit} class:amp-seg-muted={!r.lit}></div>{/if}
                    {/each}
                </div>
            </div>
            <div class="mt-1.5 flex items-center justify-between gap-2">
                <button class="amp-dot min-w-0 h-7 -ml-2 px-2 flex items-center gap-1.5 rounded-md border border-transparent cursor-pointer text-[13px] tracking-[0.06em] text-[#8cf7d4] hover:border-[#8cf7d4]/25 transition duration-150 active:scale-[0.96]"
                        title={t("amp_remote.mode")} onclick={Msg::AmpRemote(AmpRemoteMsg::Tab(AmpTab::Sound))}>
                    <div class="min-w-0 truncate">{r.mode}</div>
                    <div class="shrink-0 text-[10px] opacity-70">▶</div>
                </button>
                {#if r.main.muted}
                    <div class="amp-dot shrink-0 text-[11px] leading-none tracking-[0.08em] text-[#8cf7d4]">{r.volume_tag}</div>
                {:else}
                    <div class="amp-dot shrink-0 text-[11px] leading-none tracking-[0.08em] text-[#4fa98c]">{r.volume_tag}</div>
                {/if}
            </div>
            <div class="amp-glare absolute inset-x-0 top-0 h-[42%] pointer-events-none"></div>
        </div>
        {@const z = &r.main}{@include "AmpVolumeRow.ui"}
    </div>

    <div class="p-0.75 grid grid-cols-3 gap-0.75 rounded-[14px] border border-(--rg-bd) bg-(--rg-s2)/50" role="tablist">
        {#each [(AmpTab::Sources, "amp_remote.tab_sources", "material-symbols:input-rounded"), (AmpTab::Sound, "amp_remote.tab_sound", "material-symbols:graphic-eq-rounded"), (AmpTab::Nav, "amp_remote.tab_nav", "material-symbols:gamepad-outline-rounded")] as tab (tab.1)}
            {#if r.tab == tab.0}
                <button class="amp-tab-on h-9 flex items-center justify-center gap-1.5 rounded-[11px] text-[12.5px] font-medium cursor-pointer transition duration-150 text-(--rg-tx) active:scale-[0.96]"
                        role="tab" aria-selected="true" onclick={Msg::AmpRemote(AmpRemoteMsg::Tab(tab.0))}>
                    <Icon icon={tab.2} width={17} />
                    <div>{t(tab.1)}</div>
                </button>
            {:else}
                <button class="h-9 flex items-center justify-center gap-1.5 rounded-[11px] text-[12.5px] font-medium cursor-pointer transition duration-150 text-(--rg-mu) hover:text-(--rg-tx) active:scale-[0.96]"
                        role="tab" aria-selected="false" onclick={Msg::AmpRemote(AmpRemoteMsg::Tab(tab.0))}>
                    <Icon icon={tab.2} width={17} />
                    <div>{t(tab.1)}</div>
                </button>
            {/if}
        {/each}
    </div>

    <div class="min-h-66">
        {#if r.tab == AmpTab::Sources}
            <div class="flex flex-col gap-2.5">
                {#each r.families as family (family.0.as_str())}
                    <div class="flex flex-col">
                        {#if !family.0.is_empty()}
                            <div class="px-1 pb-1.5 text-[10.5px] font-semibold uppercase tracking-[0.12em] text-(--rg-mu)">{family.0}</div>
                        {/if}
                        <div class="grid grid-cols-4 gap-1.5">
                            {#each family.1 as c (c.id.as_str())}{@include "AmpInputTile.ui"}{/each}
                        </div>
                    </div>
                {/each}
            </div>
        {:else if r.tab == AmpTab::Sound}
            {@include "AmpRemoteSound.ui"}
        {:else}
            {@include "AmpRemoteNav.ui"}
        {/if}
    </div>
{/if}
