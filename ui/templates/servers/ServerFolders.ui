<div class="flex flex-col gap-4">
    <p class="m-0 text-sm leading-relaxed text-(--rg-tx2)">{t("servers.folders_intro")}</p>
    {#if let Some(dp) = &sv.dlna}{@include "ServerDlnaPicker.ui"}{/if}
    {#if sv.dlna.is_none()}
        {#if sv.loading}
            <div class="flex items-center gap-2 text-sm text-(--rg-mu)">
                <div class="flex animate-spin"><Icon icon="material-symbols:progress-activity" width={16} /></div><div>{t("servers.dlna_loading")}</div>
            </div>
        {:else if sv.folders.is_empty()}
            <p class="m-0 text-sm text-(--rg-mu)">{t("servers.no_folders")}</p>
        {:else}
            <div class="flex flex-col gap-1.5">
                {#each sv.folders as (i, fo) (i)}
                    {#if sv.existing.contains(&fo.0)}
                        {@const on = true}
                        <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl border transition-colors border-(--rg-gbd) bg-(--rg-gbg) cursor-default">
                            {@include "../shared/inputs/Checkbox.ui"}
                            <div class="flex shrink-0 text-(--rg-mu)"><Icon icon="material-symbols:cloud-outline-rounded" width={18} /></div>
                            <div class="flex-1 min-w-0 truncate text-sm font-semibold text-(--rg-tx)">{fo.1}</div>
                            <div class="shrink-0 text-xs text-(--rg-mu)">{t("servers.folder_added")}</div>
                        </div>
                    {:else}
                        {@const on = sv.chosen.contains(&fo.0)}
                        {#if on}
                            <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl border cursor-pointer transition-colors border-(--rg-gbd) bg-(--rg-gbg)" onclick={Msg::ServerForm(ServerFormMsg::Toggle(fo.0.clone()))}>
                                {@include "../shared/inputs/Checkbox.ui"}
                                <div class="flex shrink-0 text-(--rg-mu)"><Icon icon="material-symbols:cloud-outline-rounded" width={18} /></div>
                                <div class="flex-1 min-w-0 truncate text-sm font-semibold text-(--rg-tx)">{fo.1}</div>
                            </div>
                        {:else}
                            <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl border cursor-pointer transition-colors border-(--rg-bd) hover:border-(--rg-bd2)" onclick={Msg::ServerForm(ServerFormMsg::Toggle(fo.0.clone()))}>
                                {@include "../shared/inputs/Checkbox.ui"}
                                <div class="flex shrink-0 text-(--rg-mu)"><Icon icon="material-symbols:cloud-outline-rounded" width={18} /></div>
                                <div class="flex-1 min-w-0 truncate text-sm font-semibold text-(--rg-tx)">{fo.1}</div>
                            </div>
                        {/if}
                    {/if}
                {/each}
            </div>
        {/if}
    {/if}
    {#if let Some(e) = &sv.error}
        <div class="flex items-center gap-2 px-4 py-3 rounded-xl border border-red-500/25 bg-red-500/8 text-sm text-red-400">
            <div class="flex shrink-0"><Icon icon="material-symbols:warning-outline-rounded" width={17} /></div><div class="min-w-0">{e}</div>
        </div>
    {/if}
</div>
