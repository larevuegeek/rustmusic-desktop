<div class="home-maquette h-full flex flex-col min-h-0">
    <div class="shrink-0 flex items-end gap-6 px-4 md:px-10 pt-8 pb-5">
        {#if page.cover.is_some()}
            <img class="w-40 h-40 shrink-0 rounded-2xl object-cover shadow-[0_18px_40px_rgba(0,0,0,0.45)]" src={cx.resources.cover_opt(&page.cover)} alt="">
        {/if}
        <div class="flex flex-col gap-2 min-w-0">
            {#if !page.kicker.is_empty()}
                <div class="text-[12px] font-bold uppercase tracking-[0.12em] text-emerald-400">{page.kicker}</div>
            {/if}
            <h1 class="text-[40px] font-extrabold tracking-[-0.025em] leading-[1.05] text-neutral-900 dark:text-neutral-50 line-clamp-2">{page.title}</h1>
            <div class="text-[15px] text-neutral-500 dark:text-[#9aa39e] truncate">{page.subtitle}</div>
            {#if !page.queue.is_empty()}
                <div class="flex items-center gap-3 mt-2">
                    <button class="h-11 px-5 rounded-full bg-accent-500 hover:bg-accent-400 text-(--rg-on-g) font-bold text-[15px]
                                   flex items-center gap-2 shrink-0 whitespace-nowrap cursor-pointer transition-colors"
                            onclick={Msg::PlayPage(0)}>
                        <Icon icon="mynaui:play-solid" width={18} />
                        <div>{t("home.play")}</div>
                    </button>
                </div>
            {/if}
        </div>
    </div>

    <div class="shrink-0 grid grid-cols-[48px_minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_64px] gap-3 px-4 md:px-14 py-2
                text-[11px] font-bold uppercase tracking-[0.1em] text-(--rg-muted2) border-b border-neutral-200/60 dark:border-white/6">
        <div class="text-right">#</div>
        <div>{t("columns.title")}</div>
        <div>{t("columns.artist")}</div>
        <div>{t("columns.album")}</div>
        <div class="text-right">{t("columns.duration")}</div>
    </div>
    {#if page.rows.is_empty()}
        <div class="px-4 md:px-14 py-6 text-[14px] text-neutral-500 dark:text-[#9aa39e]">{t("tracks_view.empty_short")}</div>
    {/if}
    <k-virtual-list id="page.rows" items={page.rows.clone()} item="row" row-height="44" class="flex-1 min-h-0 px-4 md:px-10 pb-4">
        <button class="w-full h-11 grid grid-cols-[48px_minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_64px] items-center gap-3 px-4 rounded-lg text-left cursor-pointer
                       hover:bg-neutral-100 dark:hover:bg-white/6 text-[14px] text-neutral-700 dark:text-neutral-200"
                onclick={Msg::PlayPage(row.n)}>
            <div class="text-right tabular-nums text-(--rg-muted2)">{row.n + 1}</div>
            <div class="truncate font-semibold text-neutral-900 dark:text-neutral-100">{row.title}</div>
            <div class="truncate text-(--rg-mu)">{row.artist}</div>
            <div class="truncate text-(--rg-muted2)">{row.album}</div>
            <div class="text-right tabular-nums text-(--rg-muted2)">{row.duration}</div>
        </button>
    </k-virtual-list>
</div>
