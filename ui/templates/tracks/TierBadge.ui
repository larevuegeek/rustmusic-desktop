{#if row.tier == Tier::Hires}
    <div class="shrink-0 px-1.5 py-0.5 rounded-[5px] border text-[10.5px] font-bold tracking-[0.04em] text-amber-700 border-amber-300 bg-amber-50 dark:text-[#e8c46a] dark:border-[#4a3d1c] dark:bg-[#231d0e]">{row.tier_label}</div>
{:else if row.tier == Tier::Lossless}
    <div class="shrink-0 px-1.5 py-0.5 rounded-[5px] border text-[10.5px] font-bold tracking-[0.04em] text-emerald-700 border-(--rg-gbd) bg-(--rg-gbg) dark:text-[#6ee7a0] dark:bg-[#0f2016]">{row.tier_label}</div>
{:else}
    <div class="shrink-0 px-1.5 py-0.5 rounded-[5px] border text-[10.5px] font-bold tracking-[0.04em] text-(--rg-mu) border-(--rg-bd) bg-(--rg-carte) dark:border-[#2a312d]">{row.tier_label}</div>
{/if}
