<div class="mx-2.5 w-8 min-w-1 h-2 shrink rounded-full bg-(--rg-g)"></div>
<div class="flex-1"></div>
{#if win.0 == "macos"}
    <div class="shrink-0 flex items-center gap-1.5 px-2.5">
        <div class="w-3 h-3 rounded-full bg-[#ff5f57] text-[#4d0000]">
            <svg viewBox="0 0 12 12" class="w-3 h-3"><path d="M3.8 3.8l4.4 4.4M8.2 3.8l-4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
        </div>
        <div class="w-3 h-3 rounded-full bg-[#febc2e] text-[#985700]">
            <svg viewBox="0 0 12 12" class="w-3 h-3"><path d="M3 6h6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
        </div>
        <div class="w-3 h-3 rounded-full bg-[#28c840] text-[#006500]">
            <svg viewBox="0 0 12 12" class="w-3 h-3"><path d="M3 3h3.6L3 6.6zM9 9H5.4L9 5.4z" fill="currentColor" stroke="none" /></svg>
        </div>
    </div>
{:else if win.0 == "linux"}
    <div class="shrink-0 flex items-center gap-1.5 px-2">
        <div class="w-5 h-5 rounded-full flex items-center justify-center bg-white/10 text-neutral-300">
            <svg viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h8" /></svg>
        </div>
        <div class="w-5 h-5 rounded-full flex items-center justify-center bg-white/10 text-neutral-300">
            <svg viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 2.5h7v7h-7z" /></svg>
        </div>
        <div class="w-5 h-5 rounded-full flex items-center justify-center bg-white/10 text-neutral-300">
            <svg viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" /></svg>
        </div>
    </div>
{:else}
    <div class="shrink-0 flex h-full">
        <div class="w-6.5 h-full flex items-center justify-center text-neutral-300">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2 6h8" /></svg>
        </div>
        <div class="w-6.5 h-full flex items-center justify-center text-neutral-300">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 2.5h7v7h-7z" /></svg>
        </div>
        <div class="w-6.5 h-full flex items-center justify-center text-neutral-300">
            <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" /></svg>
        </div>
    </div>
{/if}
