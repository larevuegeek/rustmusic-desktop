{#if let Some(sv) = self.active_settings_view()}
<div class="reglages flex h-full">
    <div class="shrink-0 w-[300px] flex flex-col gap-3.5 px-4 pt-5 pb-4 bg-(--rg-aside) border-r border-(--rg-aside-bd) overflow-y-auto overflow-x-hidden scrollbar-app">
        <div class="shrink-0 flex items-center gap-3">
            <button class="w-10 h-10 flex items-center justify-center rounded-xl cursor-pointer transition-colors bg-(--rg-champ) border border-(--rg-bd) hover:border-(--rg-bd2) text-(--rg-tx)"
                    aria-label={t("settings.back")} title={t("settings.back")} onclick={Msg::SettingsBack}>
                <Icon icon="material-symbols:arrow-back-rounded" width={20} />
            </button>
            <h1 class="m-0 text-xl font-extrabold text-(--rg-tx)">{t("settings.title")}</h1>
        </div>
        <div class="rg-field shrink-0 h-10 flex items-center gap-2.5 px-3 rounded-[10px] cursor-text bg-(--rg-champ) border border-(--rg-bd) hover:border-(--rg-bd2)">
            <div class="shrink-0 text-(--rg-mu)"><Icon icon="material-symbols:search-rounded" width={19} /></div>
            <input class="flex-1 min-w-0 bg-transparent border-0 outline-0 text-sm text-(--rg-tx) placeholder:text-(--rg-ph) p-0"
                   type="text" value={sv.search.as_str()} oninput={|v: String| Msg::Settings(SettingsMsg::Search(v))}
                   placeholder={t("settings.search_placeholder")} aria-label={t("settings.search_placeholder")}>
            {#if !sv.search.is_empty()}
                <button class="shrink-0 flex text-(--rg-mu) hover:text-(--rg-tx) cursor-pointer" aria-label={t("settings.search_clear")}
                        onclick={Msg::Settings(SettingsMsg::Search(String::new()))}>
                    <Icon icon="material-symbols:close-rounded" width={18} />
                </button>
            {/if}
        </div>
        <div class="shrink-0 flex flex-col gap-0.5">
            {#each sv.nav as n (n.label.as_str())}
                {#if let Some(g) = &n.group}<p class="m-0 px-3 pt-4 pb-1 text-[11px] font-bold uppercase tracking-[0.08em] text-(--rg-mu2)">{g}</p>{/if}
                {#if n.active}
                    <button class="w-full flex items-center gap-3 px-3 py-2.25 rounded-[10px] leading-[1.2] text-left cursor-pointer transition-colors bg-(--rg-gbg)"
                            aria-current="page" onclick={Msg::Go(Route::Settings(n.page))}>
                        <div class="shrink-0 text-(--rg-gtx)"><Icon icon={n.icon} width={21} /></div>
                        <div class="min-w-0">
                            <div class="text-[15px] font-semibold text-(--rg-gtx)">{n.label}</div>
                            <div class="rg-nav-sous text-xs text-(--rg-mu) truncate">{n.hint}</div>
                        </div>
                    </button>
                {:else}
                    <button class="w-full flex items-center gap-3 px-3 py-2.25 rounded-[10px] leading-[1.2] text-left cursor-pointer transition-colors hover:bg-(--rg-champ)"
                            onclick={Msg::Go(Route::Settings(n.page))}>
                        <div class="shrink-0 text-(--rg-mu)"><Icon icon={n.icon} width={21} /></div>
                        <div class="min-w-0">
                            <div class="text-[15px] font-semibold text-(--rg-nav)">{n.label}</div>
                            <div class="rg-nav-sous text-xs text-(--rg-mu) truncate">{n.hint}</div>
                        </div>
                    </button>
                {/if}
            {/each}
        </div>
        <div class="mt-auto flex items-center gap-2.5 p-3 rounded-xl bg-(--rg-ver) border border-(--rg-verbd)">
            <div class="flex-1 min-w-0 leading-[1.25]">
                <p class="m-0 text-[13px] font-semibold text-(--rg-tx) truncate">{version_line()}</p>
                {#if self.update_installable()}
                    <p class="m-0 text-xs truncate text-(--rg-gtx)" title={self.update_label()}>{self.update_label()}</p>
                {:else}
                    <p class="m-0 text-xs truncate text-(--rg-mu)" title={self.update_label()}>{self.update_label()}</p>
                {/if}
            </div>
            {#if !crate::mapper::updates::update_installer::flathub()}
                {#if self.update_installable()}
                    <button class="flex items-center justify-center shrink-0 h-7.5 px-2.5 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-(--rg-g) text-white dark:text-(--rg-on-g) hover:brightness-110"
                            onclick={Msg::Banner(BannerMsg::UpdateInstall)}>
                        <div>{t("settings.update_install")}</div>
                    </button>
                {:else}
                    <button class="flex items-center justify-center shrink-0 h-7.5 px-2.5 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-(--rg-s2) text-(--rg-tx2) hover:text-(--rg-tx)"
                            onclick={Msg::Banner(BannerMsg::UpdateCheck)}>
                        <div>{t("settings.update_check")}</div>
                    </button>
                {/if}
            {/if}
        </div>
    </div>

    <div class="flex-1 min-w-0 overflow-y-auto overflow-x-hidden scrollbar-app">
        <div class="rg-contenu max-w-[820px] mx-auto px-10 pt-10 pb-15 flex flex-col gap-7" style:margin_top={-self.export_offset}>
            <div class="flex items-end justify-between gap-5">
                <div class="min-w-0">
                    <h1 class="m-0 text-[34px] leading-[1.2] font-extrabold tracking-[-0.02em] text-(--rg-tx)">{sv.title}</h1>
                    <p class="m-0 mt-1.5 text-base leading-[1.25] text-(--rg-sous)">{sv.desc}</p>
                </div>
                {#if let Some(m) = &sv.modified_items}
                    <div class="shrink-0 flex items-center gap-2.5 text-[13px] leading-[1.2] text-(--rg-sous)">
                        <div class="flex gap-1"><div class="font-bold text-(--rg-gtx)">{m.0}</div><div>{m.1}</div></div>
                        <button class="flex items-center justify-center h-7.5 px-3 rounded-lg border border-(--rg-off) hover:border-(--rg-bd2) cursor-pointer text-[13px] font-semibold text-(--rg-tx2) hover:text-(--rg-tx) transition-colors"
                                title={t("settings.restore_defaults_hint")} onclick={Msg::Settings(SettingsMsg::Restore)}>
                            <div>{t("settings.restore_defaults")}</div>
                        </button>
                    </div>
                {/if}
            </div>

            {#each sv.groups as g (g.key.as_str())}{@include "SettingsGroup.ui"}{/each}
            {#if let Some(none_found) = &sv.none_found}
                <div class="flex flex-col items-center gap-2 py-16 text-center">
                    <div class="text-(--rg-mu2)"><Icon icon="material-symbols:search-off-rounded" width={32} /></div>
                    <p class="m-0 text-[15px] font-semibold text-(--rg-tx)">{none_found}</p>
                    <p class="m-0 text-[13px] text-(--rg-mu)">{t("settings.search_empty_hint")}</p>
                </div>
            {/if}
        </div>
    </div>
</div>
{/if}
