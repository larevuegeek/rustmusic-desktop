{#if let Some(mode) = &c.preview.theme()}
    <div class="relative h-24 rounded-lg overflow-hidden">
        {#if *mode == "auto"}
            {@const e = (theme_palette(false), false)}{@include "SettingsThemeScreen.ui"}
            <div class="rg-moitie-claire absolute inset-0">
                {@const e = (theme_palette(true), false)}{@include "SettingsThemeScreen.ui"}
            </div>
        {:else}
            {@const e = (theme_palette(*mode == "light"), true)}{@include "SettingsThemeScreen.ui"}
        {/if}
    </div>
{/if}
{#if let Some(placement) = &c.preview.library()}
    {#if *placement == "sidebar"}
        <div class="h-17.5 grid grid-cols-[32%_1fr] gap-1 p-1.25 rounded-[7px] border bg-[#f6f4ef] dark:bg-[#0b0d0c] border-neutral-200 dark:border-[#1f2522]">
            <div class="rounded bg-(--rg-gbg) border border-(--rg-gbd)"></div>
            <div class="rounded bg-[#ebe7df] dark:bg-[#1b211e]"></div>
        </div>
    {:else}
        <div class="h-17.5 flex gap-1 p-1.25 rounded-[7px] border bg-[#f6f4ef] dark:bg-[#0b0d0c] border-neutral-200 dark:border-[#1f2522]">
            {#if *placement == "top"}
                <div class="w-[32%] shrink-0 rounded bg-[#ebe7df] dark:bg-[#1b211e]"></div>
            {:else}
                <div class="w-[32%] shrink-0 rounded bg-(--rg-gbg) border border-(--rg-gbd)"></div>
            {/if}
            <div class="flex-1 min-w-0 flex flex-col gap-1">
                <div class="h-3 shrink-0 rounded bg-(--rg-gbg) border border-(--rg-gbd)"></div>
                <div class="flex-1 rounded bg-[#ebe7df] dark:bg-[#1b211e]"></div>
            </div>
        </div>
    {/if}
{/if}
{#if let Some(win) = &c.preview.window()}
    <div class="h-18 rounded-lg overflow-hidden flex flex-col border bg-[#f6f4ef] dark:bg-[#0b0d0c] border-neutral-200 dark:border-[#1f2522]">
        {#if win.1}
            <div class="h-9 shrink-0 flex flex-row-reverse items-center border-b bg-[#efece5] dark:bg-[#080a09] border-[#e2ddd3] dark:border-[#161a18]">{@include "SettingsWindowButtons.ui"}</div>
        {:else}
            <div class="h-9 shrink-0 flex items-center border-b bg-[#efece5] dark:bg-[#080a09] border-[#e2ddd3] dark:border-[#161a18]">{@include "SettingsWindowButtons.ui"}</div>
        {/if}
        <div class="flex-1 flex flex-col gap-1.25 p-2">
            <div class="h-1.25 w-3/5 rounded-[3px] bg-[#d8d3c8] dark:bg-[#2a312d]"></div>
            <div class="h-1.25 w-2/5 rounded-[3px] bg-[#d8d3c8] dark:bg-[#2a312d]"></div>
        </div>
    </div>
{/if}
