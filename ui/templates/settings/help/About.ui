{#if r.custom() == "about-card"}
    <div class="relative overflow-hidden flex items-center gap-5 p-6">
        <div class="absolute -top-28 -right-20 w-72 h-72 rounded-full bg-(--rg-g) opacity-12 blur-[80px]"></div>
        <div class="relative flex-1 min-w-0 leading-[1.2]">
            <p class="m-0 text-[30px] font-extrabold tracking-[-0.02em] text-(--rg-tx)">Rust<span class="text-(--rg-gtx)">Music</span></p>
            <p class="m-0 mt-1.5 text-sm text-(--rg-mu)">{t("about.tagline")}</p>
            <div class="mt-3.5 flex flex-wrap items-center gap-2">
                <SettingsBadge text={version_tag()} tone={"green".to_string()} />
                <SettingsBadge text={t("settings.beta_badge")} tone={"amber".to_string()} />
                <div class="text-[13px] text-(--rg-mu)">{self.update_label()}</div>
            </div>
            <div class="mt-3.5 flex items-center gap-1 text-[13px] text-(--rg-mu)">
                <div>{t("about.developed_by")}</div>
                <button class="font-semibold text-(--rg-tx2) hover:text-(--rg-gtx) transition-colors cursor-pointer"
                        onclick={Msg::Settings(SettingsMsg::OpenUrl("https://larevuegeek.fr"))}><div>LaRevueGeeK</div></button>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
                <button class="h-9 flex items-center gap-2 px-3.5 rounded-lg border transition-colors text-[13px] font-semibold cursor-pointer bg-(--rg-tx) border-(--rg-tx) text-(--rg-carte) hover:opacity-90"
                        onclick={Msg::Settings(SettingsMsg::OpenUrl(crate::mapper::feedback::REPOSITORY_URL))}>
                    <Icon icon="simple-icons:github" width={15} />
                    <div>{t("about.source_code")}</div>
                </button>
                <button class="h-9 flex items-center gap-2 px-3.5 rounded-lg border transition-colors text-[13px] font-semibold cursor-pointer bg-(--rg-creux) border-(--rg-line) hover:border-(--rg-bd2) text-(--rg-tx2) hover:text-(--rg-tx)"
                        onclick={Msg::Settings(SettingsMsg::OpenUrl(crate::mapper::feedback::ISSUES_URL))}>
                    <Icon icon="material-symbols:bug-report-outline-rounded" width={15} />
                    <div>{t("about.report_bug")}</div>
                </button>
                <button class="h-9 flex items-center gap-2 px-3.5 rounded-lg border transition-colors text-[13px] font-semibold cursor-pointer bg-(--rg-creux) border-(--rg-line) hover:border-(--rg-bd2) text-(--rg-tx2) hover:text-(--rg-tx)"
                        onclick={Msg::Settings(SettingsMsg::OpenUrl("https://rustmusic.dev"))}>
                    <Icon icon="material-symbols:public" width={15} />
                    <div>rustmusic.dev</div>
                </button>
            </div>
        </div>
        <div class="relative">
            <GhostButton g={Some(Ghost::new("material-symbols:sync-rounded", t("about.check_updates"), Msg::Banner(BannerMsg::UpdateCheck)))} />
        </div>
    </div>
{:else if r.custom() == "about-support"}
    <div class="relative overflow-hidden p-5">
        <div class="absolute -top-24 -right-16 w-60 h-60 rounded-full bg-amber-500 opacity-10 blur-[70px]"></div>
        <p class="relative m-0 text-[13px] leading-relaxed text-(--rg-mu) max-w-xl">{t("support.about_text")}</p>
        <div class="relative mt-4 flex flex-wrap gap-2">
            {#each about_support() as link (link.0)}
                {#if link.3}
                    <button class="h-9 flex items-center gap-2 px-3.5 rounded-lg border transition-colors text-[13px] font-semibold cursor-pointer bg-amber-500 border-amber-500 text-neutral-950 hover:bg-amber-400"
                            onclick={Msg::Settings(SettingsMsg::OpenUrl(link.0))}>
                        <Icon icon={link.1} width={15} />
                        <div>{t(link.2)}</div>
                    </button>
                {:else}
                    <button class="h-9 flex items-center gap-2 px-3.5 rounded-lg border transition-colors text-[13px] font-semibold cursor-pointer bg-(--rg-creux) border-(--rg-line) hover:border-(--rg-bd2) text-(--rg-tx2) hover:text-(--rg-tx)"
                            onclick={Msg::Settings(SettingsMsg::OpenUrl(link.0))}>
                        <Icon icon={link.1} width={15} />
                        <div>{t(link.2)}</div>
                    </button>
                {/if}
            {/each}
        </div>
    </div>
{:else if r.custom() == "about-stack"}
    <div class="flex items-start gap-4 px-5 py-4">
        <p class="m-0 w-36 shrink-0 pt-1.5 text-[15px] font-semibold leading-[1.2] text-(--rg-tx)">{r.title}</p>
        <div class="flex-1 min-w-0 flex flex-wrap gap-1.5">
            {#each self.about_stack(&r.key) as lib (lib.0)}
                <button class="h-8 flex items-center gap-1.5 pl-2.5 pr-3 rounded-lg border transition-colors cursor-pointer bg-(--rg-creux) border-(--rg-line) hover:border-(--rg-bd2) text-[13px] font-semibold text-(--rg-tx2) hover:text-(--rg-tx)"
                        onclick={Msg::Settings(SettingsMsg::OpenUrl(lib.2))}>
                    <div class="flex text-(--rg-mu)"><Icon icon={lib.3} width={15} /></div>
                    <div>{lib.0}</div>
                    <div class="font-mono text-[11px] font-normal text-(--rg-mu2)">{lib.1}</div>
                </button>
            {/each}
        </div>
    </div>
{:else if r.custom() == "about-license"}
    <div class="px-5 pb-5 pt-4">
        <p class="m-0 text-[13px] leading-relaxed text-(--rg-mu)">{t("about.license_text")}</p>
        <button class="mt-2 flex items-center gap-1.5 text-[13px] font-semibold text-(--rg-gtx) hover:underline cursor-pointer"
                onclick={Msg::Settings(SettingsMsg::OpenUrl("https://www.gnu.org/licenses/gpl-3.0.html"))}>
            <Icon icon="material-symbols:open-in-new-rounded" width={14} />
            <div>{t("about.license_full")}</div>
        </button>
    </div>
{/if}
