<div class="flex flex-col min-h-0 max-h-[calc(88vh_-_69px)]">
    {#if let Some(lk) = &e.lookup}{@include "TagLookup.ui"}{/if}
    {#if e.lookup.is_none()}
        <div class="min-h-0 flex max-h-[calc(88vh_-_138px)]">
            <div class="shrink-0 w-64 flex flex-col gap-3.5 p-4 overflow-y-auto scrollbar-none border-r border-(--rg-bd) bg-(--rg-creux)">
                {@include "TagEditorMedia.ui"}
            </div>
            <div class="flex-1 min-w-0 flex flex-col min-h-0">
                <div class="shrink-0 flex items-center gap-2 px-4 py-2 border-b border-(--rg-bd)">
                    {#if e.filled.is_empty()}
                        <div class="flex-1"></div>
                    {:else}
                        <div class="flex-1 min-w-0 flex items-center gap-1.5 text-[11px] font-medium truncate text-(--rg-gtx)">
                            <div class="flex shrink-0"><Icon icon="lucide:sparkles" width={11} /></div><div class="truncate">{e.filled_label()}</div>
                        </div>
                    {/if}
                    {#if e.loading || e.busy}
                        <div class="shrink-0 flex items-center gap-1.5 px-3 h-8 rounded-xl text-[12px] font-semibold opacity-40 border border-(--rg-gbd) bg-(--rg-gbg) text-(--rg-gtx)">
                            <Icon icon="lucide:cloud-download" width={12} /><div>{t("source.fetch")}</div>
                        </div>
                    {:else}
                        <button class="shrink-0 flex items-center gap-1.5 px-3 h-8 rounded-xl text-[12px] font-semibold cursor-pointer transition-colors border border-(--rg-gbd) bg-(--rg-gbg) text-(--rg-gtx) hover:border-(--rg-g)"
                                onclick={Msg::TagEditor(TagEditorMsg::Fetch)}>
                            <Icon icon="lucide:cloud-download" width={12} /><div>{t("source.fetch")}</div>
                        </button>
                    {/if}
                </div>
                <div class="min-w-0 min-h-0 overflow-y-auto scrollbar-none px-5 py-4 flex flex-col gap-5">
                    {#if e.loading}
                        {#each [2usize, 4, 2] as (g, rows) (g)}
                            <div class="flex flex-col gap-2">
                                <div class="h-2 w-20 rounded bg-(--rg-s2) animate-pulse"></div>
                                <div class="flex flex-col gap-1.5">
                                    {#each (0..rows).collect::<Vec<_>>() as k (k)}<div class="h-13 rounded-xl animate-pulse bg-(--rg-champ) border border-(--rg-bd)"></div>{/each}
                                </div>
                            </div>
                        {/each}
                    {:else}
                        <div>
                            {@const gt = t("tags.section_track")}{@include "TagEditorGroupTitle.ui"}
                            <div class="flex flex-col gap-1.5">
                                {#each [(0usize, true, false), (1, false, false)] as (k, fd) (k)}{@include "TagEditorField.ui"}{/each}
                            </div>
                        </div>
                        <div>
                            {@const gt = t("tags.section_album")}{@include "TagEditorGroupTitle.ui"}
                            <div class="flex flex-col gap-1.5">
                                {#each [(2usize, false, false), (3, false, false)] as (k, fd) (k)}{@include "TagEditorField.ui"}{/each}
                                <div class="grid grid-cols-3 gap-1.5">
                                    {@const fd = (4usize, false, false)}{@include "TagEditorField.ui"}
                                    <div class="col-span-2">
                                        {@const fd = (5usize, false, false)}{@include "TagEditorField.ui"}
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-1.5">
                                    {#each [(t("tags.track_short"), 8usize, 9usize), (t("tags.disc_short"), 10, 11)] as (k, pr) (k)}{@include "TagEditorPair.ui"}{/each}
                                </div>
                            </div>
                        </div>
                        <div>
                            {@const gt = t("tags.section_extra")}{@include "TagEditorGroupTitle.ui"}
                            <div class="flex flex-col gap-1.5">
                                {#each [(6usize, false, false), (7, false, true)] as (k, fd) (k)}{@include "TagEditorField.ui"}{/each}
                            </div>
                        </div>
                    {/if}
                </div>
            </div>
        </div>
    {/if}

    {#if let Some(err) = &e.error}
        <div class="shrink-0 flex items-start gap-2 px-6 py-2.5 bg-red-500/8 border-t border-red-500/20 text-red-400 text-xs">
            <div class="flex shrink-0 mt-px"><Icon icon="lucide:alert-triangle" width={14} /></div><div class="min-w-0">{err}</div>
        </div>
    {/if}

    {#if e.confirming && e.dirty()}
        <div class="shrink-0 flex items-center gap-3 px-6 py-2.5 bg-(--rg-ambg) border-t border-(--rg-ambd)">
            <div class="flex shrink-0 text-(--rg-am)"><Icon icon="lucide:triangle-alert" width={15} /></div>
            <div class="flex-1 min-w-0 text-[12px] font-medium text-(--rg-amtx)">{t("tags.unsaved")}</div>
            <button class="px-3.5 h-8 flex items-center rounded-xl text-[12px] font-semibold cursor-pointer transition-colors text-(--rg-amtx) hover:bg-(--rg-am)/15"
                    onclick={Msg::TagEditor(TagEditorMsg::Discard)}><div>{t("tags.discard")}</div></button>
            <button class="flex items-center gap-1.5 px-3.5 h-8 rounded-xl text-[12px] font-bold cursor-pointer transition bg-(--rg-am) text-(--rg-ambg) hover:brightness-110"
                    onclick={Msg::TagEditor(TagEditorMsg::KeepEditing)}><div>{t("tags.keep_editing")}</div></button>
        </div>
    {/if}

    <div class="shrink-0 flex items-center gap-3 px-6 py-3.5 border-t border-(--rg-bd) bg-(--rg-creux)">
        <div class="flex-1 min-w-0 flex items-center gap-2">
            {#if e.dirty()}
                <div class="flex items-center gap-1.5 text-[12px] font-medium text-(--rg-tx2)">
                    <div class="w-1.5 h-1.5 rounded-full bg-(--rg-g) shadow-[0_0_6px_rgba(34,197,94,1)]"></div>
                    <div>{tag_editor_summary(e)}</div>
                </div>
                <button class="text-[12px] cursor-pointer underline underline-offset-2 text-(--rg-mu) hover:text-(--rg-tx) transition-colors"
                        onclick={Msg::TagEditor(TagEditorMsg::RevertAll)}><div>{t("tags.reset_all")}</div></button>
            {:else}
                <div class="text-[12px] text-(--rg-mu)">{t("tags.no_change")}</div>
            {/if}
            <div class="flex text-(--rg-mu2) cursor-help hover:text-(--rg-tx2) transition-colors" title={t("tags.clear_hint")}><Icon icon="lucide:info" width={12} /></div>
        </div>
        <div class="px-1.5 py-0.5 rounded-md text-[10px] font-semibold tabular-nums bg-(--rg-carte) border border-(--rg-bd) text-(--rg-mu)">Ctrl ↵</div>
        <button class="h-10 px-4 flex items-center rounded-xl text-sm font-semibold cursor-pointer transition-colors text-(--rg-tx2) hover:bg-(--rg-hover) hover:text-(--rg-tx)"
                onclick={Msg::TagEditor(TagEditorMsg::Close)}><div>{t("profil.cancel")}</div></button>
        {#if e.dirty() && !e.busy}
            <button class="h-10 pl-4 pr-5 rounded-xl text-sm font-bold cursor-pointer flex items-center gap-2 transition hover:brightness-110 bg-(--rg-g) text-(--rg-on-g)"
                    onclick={Msg::TagEditor(TagEditorMsg::Submit)}><Icon icon="lucide:check" width={17} /><div>{t("profil.save")}</div></button>
        {:else}
            <div class="h-10 pl-4 pr-5 rounded-xl text-sm font-bold flex items-center gap-2 bg-(--rg-g) text-(--rg-on-g) opacity-40 cursor-default">
                {#if e.busy}<div class="flex animate-spin"><Icon icon="lucide:loader-2" width={17} /></div>{:else}<Icon icon="lucide:check" width={17} />{/if}
                <div>{t("profil.save")}</div>
            </div>
        {/if}
    </div>
</div>

{#if let Some(zs) = &e.zoomed.and_then(|z| e.slots.get(z))}
    <div class="fixed inset-0 z-[60] flex flex-col items-center justify-center gap-3 p-10 bg-black/88 backdrop-blur-md cursor-pointer animate-[popin-fade-in_150ms_linear]" data-exit="popin-fade-out 150ms linear" onclick={Msg::TagEditor(TagEditorMsg::Zoom(None))}>
        <img class="max-w-full max-h-[72vh] object-contain rounded-xl shadow-2xl ring-1 ring-white/10" src={cx.resources.cover(&zs.src)} alt={tag_editor_type(zs.picture_type)}>
        <div class="text-center">
            <p class="m-0 text-sm font-medium text-white/90">{tag_editor_type(zs.picture_type)}</p>
            <p class="m-0 text-[11px] text-white/50">{zs.zoom_summary()}</p>
        </div>
    </div>
{/if}
