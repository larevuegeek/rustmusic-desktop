<div class="group relative min-w-0">
    <button class="min-w-0 flex flex-col gap-2.5" onclick={go} title={p.name.as_str()}>
        <div class="relative block">
            <div class="relative block overflow-hidden isolate aspect-square w-full rounded-2xl shadow-[0_10px_26px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_26px_rgba(0,0,0,0.5)] transition-transform duration-200 group-hover:-translate-y-0.5 playlist-backdrop"
                 style:--c={hex(&p.color)}>
                {#if let Some(four) = mosaic(&p.covers)}
                    <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-px bg-black/20">
                        {#each four as c (c)}
                            <img class="w-full aspect-square object-cover" src={cx.resources.cover(c)} alt="">
                        {/each}
                    </div>
                {:else if let Some(cover) = p.covers.first()}
                    <img class="absolute inset-0 w-full h-full object-cover" src={cx.resources.cover(cover)} alt="">
                {:else}
                    <div class="absolute inset-0 flex items-center justify-center text-white/90"><Icon icon={p.icon.clone()} width={44} /></div>
                {/if}
                <div class="absolute inset-0 ring-1 ring-inset ring-black/8 dark:ring-white/8 pointer-events-none rounded-2xl"></div>
            </div>
            {#if p.auto}
                <div class="absolute left-2 top-2 h-6 px-2 inline-flex items-center gap-1 rounded-full text-[11px] font-bold bg-black/55 text-white backdrop-blur-sm">
                    <Icon icon="material-symbols:auto-awesome-rounded" width={13} />
                    <div>{t("playlists_view.kind_smart")}</div>
                </div>
            {/if}
        </div>
        <div class="min-w-0 px-0.5">
            <div class="block truncate text-[15px] font-bold text-(--rg-tx)">{p.name}</div>
            <div class="block truncate text-[13px] text-(--rg-mu)">{p.subtitle}</div>
        </div>
    </button>
</div>
