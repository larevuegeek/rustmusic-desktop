{#if self.views.view_mode == ViewMode::List}
    <div class="group w-full flex items-center gap-2 rounded-xl hover:bg-(--rg-hover) transition-colors">
        <button class="flex-1 min-w-0 flex items-center gap-3.5 px-2 py-2 text-left cursor-pointer" onclick={Msg::Go(p.route.clone())} oncontextmenu={{ let r = p.route.clone(); move |q: ContextMenuRequest| match &r { Route::Playlist(id) => Msg::PlaylistMenu(PlaylistMenuMsg::Open(TrackMenuAt::from_request(&q), *id)), _ => Msg::Noop } }}>
            <div class="relative w-12 h-12 shrink-0 rounded-lg overflow-hidden playlist-backdrop" style:--c={hex(&p.color)}>
                {#if let Some(four) = mosaic(&p.covers)}
                    <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-px bg-black/20">
                        {#each four as c (c.as_str())}<img class="w-full aspect-square object-cover" src={cx.resources.cover_small_path(&c)} alt="">{/each}
                    </div>
                {:else if let Some(cover) = p.covers.first()}
                    <img class="absolute inset-0 w-full h-full object-cover" src={cx.resources.cover_small_path(cover)} alt="">
                {:else}
                    <div class="absolute inset-0 flex items-center justify-center text-white/90"><Icon icon={p.icon.clone()} width={22} /></div>
                {/if}
                <div class="absolute inset-0 rounded-lg ring-1 ring-inset ring-black/8 dark:ring-white/8 pointer-events-none"></div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                    <div class="truncate text-[15px] font-semibold text-(--rg-tx)">{p.name}</div>
                    {#if p.auto}<div class="shrink-0 text-violet-500 dark:text-violet-300"><Icon icon="material-symbols:auto-awesome-outline-rounded" width={15} /></div>{/if}
                </div>
                <div class="truncate text-[13px] text-(--rg-mu)">{p.subtitle}</div>
            </div>
        </button>
        {#each p.pinned.iter() as pin (pin.0)}
            {#if pin.1}
                <button class="shrink-0 mr-2 w-9 h-9 flex items-center justify-center rounded-full cursor-pointer transition text-(--rg-gtx)"
                        aria-pressed="true" title={t("sidebar.unpin")} onclick={Msg::Playlists(PlaylistsMsg::Pin(pin.0, false))}><Icon icon="material-symbols:keep-rounded" width={19} /></button>
            {:else}
                <button class="shrink-0 mr-2 w-9 h-9 flex items-center justify-center rounded-full cursor-pointer transition text-(--rg-mu2) opacity-0 group-hover:opacity-100 hover:text-(--rg-tx)"
                        aria-pressed="false" title={t("sidebar.pin")} onclick={Msg::Playlists(PlaylistsMsg::Pin(pin.0, true))}><Icon icon="material-symbols:keep-outline-rounded" width={19} /></button>
            {/if}
        {/each}
    </div>
{:else}
    <div class="group relative min-w-0">
        <button class="w-full min-w-0 flex flex-col gap-2.5 text-left cursor-pointer" onclick={Msg::Go(p.route.clone())} oncontextmenu={{ let r = p.route.clone(); move |q: ContextMenuRequest| match &r { Route::Playlist(id) => Msg::PlaylistMenu(PlaylistMenuMsg::Open(TrackMenuAt::from_request(&q), *id)), _ => Msg::Noop } }}>
            <div class="relative w-full">
                <div class="relative overflow-hidden aspect-square w-full rounded-2xl shadow-[0_10px_26px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_26px_rgba(0,0,0,0.5)] transition-transform duration-200 group-hover:-translate-y-0.5 playlist-backdrop"
                     style:--c={hex(&p.color)}>
                    {#if let Some(four) = mosaic(&p.covers)}
                        <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-px bg-black/20">
                            {#each four as c (c.as_str())}<img class="w-full aspect-square object-cover" src={cx.resources.cover_small_path(&c)} alt="">{/each}
                        </div>
                    {:else if let Some(cover) = p.covers.first()}
                        <img class="absolute inset-0 w-full h-full object-cover" src={cx.resources.cover(cover)} alt="">
                    {:else}
                        <div class="absolute inset-0 flex items-center justify-center text-white/90"><Icon icon={p.icon.clone()} width={44} /></div>
                    {/if}
                    <div class="absolute inset-0 ring-1 ring-inset ring-black/8 dark:ring-white/8 pointer-events-none rounded-2xl"></div>
                </div>
                {#if p.auto}
                    <div class="absolute left-2 top-2 h-6 px-2 inline-flex items-center gap-1 rounded-full text-[11px] font-bold bg-black/55 text-white backdrop-blur-sm">
                        <Icon icon="material-symbols:auto-awesome-rounded" width={13} /><div>{t("playlists_view.smart_badge")}</div>
                    </div>
                {/if}
            </div>
            <div class="w-full min-w-0 px-0.5">
                <div class="truncate text-[15px] font-bold text-(--rg-tx)">{p.name}</div>
                <div class="truncate text-[13px] text-(--rg-mu)">{p.subtitle}</div>
            </div>
        </button>
        {#each p.pinned.iter() as pin (pin.0)}
            {#if pin.1}
                <button class="absolute right-2 top-2 w-8 h-8 flex items-center justify-center rounded-full cursor-pointer transition bg-black/55 text-white backdrop-blur-sm hover:bg-black/75"
                        aria-pressed="true" title={t("sidebar.unpin")} onclick={Msg::Playlists(PlaylistsMsg::Pin(pin.0, false))}><Icon icon="material-symbols:keep-rounded" width={17} /></button>
            {:else}
                <button class="absolute right-2 top-2 w-8 h-8 flex items-center justify-center rounded-full cursor-pointer transition bg-black/55 text-white backdrop-blur-sm hover:bg-black/75 opacity-0 group-hover:opacity-100"
                        aria-pressed="false" title={t("sidebar.pin")} onclick={Msg::Playlists(PlaylistsMsg::Pin(pin.0, true))}><Icon icon="material-symbols:keep-outline-rounded" width={17} /></button>
            {/if}
        {/each}
    </div>
{/if}
