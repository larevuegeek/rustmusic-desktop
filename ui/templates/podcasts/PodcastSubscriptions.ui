{@const pv = self.podcasts_view()}
{#if !pv.active}
    <div class="flex flex-col items-center justify-center gap-3 h-full text-(--rg-mu)">
        <Icon icon="material-symbols:podcasts-rounded" width={34} />
        <p class="text-sm m-0">{t("podcasts.disabled")}</p>
    </div>
{:else}
<div class="biblio-maquette flex flex-col h-full">
    <div class="shrink-0 flex flex-wrap items-center gap-x-5 gap-y-4 px-4 md:pl-8 md:pr-14 pt-6 pb-4">
        <div class="w-16 h-16 shrink-0 rounded-2xl border flex items-center justify-center text-violet-600 dark:text-violet-300 bg-violet-500/10 border-violet-500/25">
            <Icon icon="material-symbols:podcasts-rounded" width={30} />
        </div>
        <div class="flex-[1_1_240px] min-w-60">
            <button class="text-xs font-bold uppercase tracking-widest text-(--rg-mu) hover:text-(--rg-tx) cursor-pointer" onclick={Msg::Go(Route::Podcasts)}><div>{t("podcasts.title")}</div></button>
            <h1 class="m-0 mt-0.5 mb-1.5 text-[34px] font-extrabold tracking-[-0.02em] leading-tight text-(--rg-tx)">{t("podcasts.my_podcasts")}</h1>
            <div class="flex gap-1 text-sm text-(--rg-mu)">
                {@const count = self.podcasts_count()}
                <div class="font-bold text-(--rg-tx)">{count.0}</div>
                <div>{count.1}</div>
            </div>
        </div>
    </div>
    <div class="@container shrink-0 pl-4 md:pl-8 pr-4 md:pr-14 py-3 border-t border-(--rg-line)">
        <div class="flex flex-wrap items-center gap-2.5">
            <SearchField class="w-65 @max-4xl:flex-1 min-w-36" value={pv.filtre.clone()} placeholder={pv.filtre_placeholder.clone()} clear_label={t("podcasts.clear")} field={Field::PageSearch} />
            <div class="flex-1"></div>
            <MenuSelect anchor="podcasts.sort" open={self.popup("podcasts.sort")} label={pv.sort_label.clone()} icon={pv.sort_icon} options={pv.sorts.clone()} />
        </div>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-app pl-4 md:pl-8 pr-10 md:pr-14 pt-4 pb-16">
        {#if pv.subscriptions.is_empty() && !pv.filtre.trim().is_empty()}
            <EmptyResult message={t("podcasts.no_match")} clear_label={t("podcasts.clear")} onclear={Some(Msg::Podcasts(PodcastsMsg::Filter(String::new())))} />
        {:else if self.podcasts_empty()}
            <p class="m-0 mt-4 max-w-md text-sm leading-relaxed text-(--rg-mu)">{t("podcasts.empty")}</p>
        {:else}
            <div class="grid grid-cols-[repeat(auto-fill,minmax(176px,1fr))] gap-x-5 gap-y-7">
                {#each pv.subscriptions as p (p.id)}{@include "PodcastCard.ui"}{/each}
            </div>
        {/if}
    </div>
</div>
{/if}
