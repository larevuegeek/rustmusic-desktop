<script lang="ts">
  // Épisodes téléchargés du profil, par émission : place occupée, écoute, suppression.
  import Icon from "@iconify/svelte";
  import { invoke } from "@tauri-apps/api/core";
  import { t, currentLocale } from "#lib/i18n";
  import { settingsStore } from "#lib/stores/settings/settings.store";
  import { profilSelector } from "#lib/stores/profil/profil.store";
  import { player } from "#lib/stores/player/player.store";
  import { toasts } from "#lib/stores/ui/toast.store";
  import { readableSize } from "#lib/helper/tools/sizeTools";
  import { episodeDate, episodeDuration } from "#lib/helper/tools/podcastFormat";
  import { playEpisode, deleteEpisodeDownload } from "#lib/actions/podcast/PodcastAction";
  import PageState from "#lib/components/ui/layout/PageState.svelte";
  import PodcastCover from "#lib/components/podcast/PodcastCover.svelte";
  import type { DownloadView, EpisodeView, PodcastView } from "#lib/types/ui/podcast/Podcast";

  const actif = $derived($settingsStore.podcasts === "true");
  const profilId = $derived($profilSelector.profilSelected?.id ?? null);

  let liste = $state<DownloadView[] | null>(null);
  async function load() {
    if (profilId == null) return;
    try {
      liste = await invoke<DownloadView[]>("get_podcast_downloads", { profilId });
    } catch (e) {
      console.error("[podcasts] téléchargements :", e);
      liste = [];
    }
  }
  $effect(() => { if (actif && profilId != null) load(); });

  const taille = (n: number) => readableSize(n, $currentLocale) || "0";
  const total = $derived((liste ?? []).reduce((s, d) => s + d.size, 0));
  const ecoutes = $derived((liste ?? []).filter((d) => d.played));

  // Regroupés par émission, dans l'ordre du plus récent téléchargé.
  const groupes = $derived.by(() => {
    const m = new Map<number, { id: number; titre: string; cover: string | null; items: DownloadView[]; size: number }>();
    for (const d of liste ?? []) {
      const g = m.get(d.podcast_id) ?? { id: d.podcast_id, titre: d.podcast_title, cover: d.cover_path, items: [], size: 0 };
      g.items.push(d);
      g.size += d.size;
      m.set(d.podcast_id, g);
    }
    return [...m.values()];
  });

  async function vider(podcastId: number | null, playedOnly: boolean) {
    if (profilId == null) return;
    try {
      const [n, octets] = await invoke<[number, number]>("podcast_delete_downloads", { profilId, podcastId, playedOnly });
      toasts.push({ type: "success", title: $t("podcasts.freed").replace("{n}", String(n)).replace("{size}", taille(octets)) });
    } catch (e) {
      toasts.push({ type: "error", title: $t("notify.error"), message: String(e) });
    }
    confirmer = null;
    await load();
  }

  async function supprimer(d: DownloadView) {
    try {
      await deleteEpisodeDownload(d.id);
      liste = (liste ?? []).filter((x) => x.id !== d.id);
    } catch (e) {
      toasts.push({ type: "error", title: $t("notify.error"), message: String(e) });
    }
  }

  // Lire depuis ici : la file suit l'ordre de la liste, émission comprise.
  function play(d: DownloadView, suite: DownloadView[]) {
    const podcast = { title: d.podcast_title, cover_path: d.cover_path } as PodcastView;
    const ep = (x: DownloadView) => ({ ...x, path: x.file_path }) as unknown as EpisodeView;
    playEpisode(podcast, ep(d), suite.map(ep));
  }

  /** Suppression en attente de confirmation : `all`, `played`, ou l'id d'une émission. */
  let confirmer = $state<"all" | "played" | number | null>(null);
</script>

{#if !actif}
  <PageState icon="material-symbols:podcasts-rounded" message={$t("podcasts.disabled")} lien={{ href: "/settings/online", label: $t("podcasts.disabled_link") }} />
{:else if liste === null}
  <PageState chargement message={$t("common.loading")} />
{:else}
<div class="biblio-maquette flex flex-col h-full">
  <!-- ─── En-tête ─── -->
  <div class="shrink-0 flex flex-wrap items-center gap-x-5 gap-y-4 px-4 md:pl-8 md:pr-14 pt-6 pb-4">
    <div class="w-16 h-16 shrink-0 rounded-2xl border flex items-center justify-center text-violet-600 dark:text-violet-300
                bg-violet-500/10 border-violet-500/25 max-sm:w-12 max-sm:h-12">
      <Icon icon="material-symbols:download-for-offline-outline-rounded" width="30" />
    </div>
    <div class="flex-[1_1_240px] min-w-60">
      <a href="/podcasts" class="text-xs font-bold uppercase tracking-widest text-(--rg-mu) hover:text-(--rg-tx)">{$t("podcasts.title")}</a>
      <h1 class="mt-0.5 mb-1.5 text-[34px] max-sm:text-2xl font-extrabold tracking-[-0.02em] leading-tight text-(--rg-tx)">{$t("podcasts.downloads")}</h1>
      <div class="flex flex-wrap items-baseline gap-x-4.5 gap-y-1.5 text-sm text-(--rg-mu)">
        <span><b class="font-bold text-(--rg-tx)">{liste.length.toLocaleString($currentLocale)}</b> {$t(liste.length === 1 ? "podcasts.episodes_one" : "podcasts.episodes_n")}</span>
        <span><b class="font-bold text-(--rg-tx)">{taille(total)}</b> {$t("podcasts.on_disk")}</span>
      </div>
    </div>
    {#if liste.length > 0}
      <div class="flex flex-wrap items-center gap-2.5">
        {#if confirmer === "all" || confirmer === "played"}
          <span class="h-10 pl-4 pr-1.5 inline-flex items-center gap-2 rounded-xl border text-[13px] bg-red-500/8 border-red-500/35 text-(--rg-tx)">
            {confirmer === "all" ? $t("podcasts.delete_all_confirm") : $t("podcasts.delete_played_confirm")}
            <button type="button" onclick={() => (confirmer = null)} class="h-7.5 px-2.5 rounded-lg cursor-pointer font-semibold text-(--rg-tx2) hover:bg-(--rg-s2)">{$t("common.cancel")}</button>
            <button type="button" onclick={() => vider(null, confirmer === "played")} class="h-7.5 pl-2 pr-3 inline-flex items-center gap-1.5 rounded-lg cursor-pointer font-bold bg-red-600 text-white hover:bg-red-500"><Icon icon="material-symbols:delete-outline-rounded" width="17" />{$t("common.delete")}</button>
          </span>
        {:else}
          {#if ecoutes.length > 0}
            <button type="button" onclick={() => (confirmer = "played")}
                    class="h-10 px-4 inline-flex items-center gap-2 rounded-xl border cursor-pointer text-sm font-semibold transition-colors border-(--rg-bd2) text-(--rg-tx) hover:border-(--rg-gbd) hover:text-(--rg-gtx)">
              <Icon icon="material-symbols:done-all-rounded" width="18" />{$t("podcasts.delete_played").replace("{n}", String(ecoutes.length))}
            </button>
          {/if}
          <button type="button" onclick={() => (confirmer = "all")}
                  class="h-10 px-4 inline-flex items-center gap-2 rounded-xl border cursor-pointer text-sm font-semibold transition-colors border-(--rg-bd2) text-(--rg-tx) hover:border-red-400/60 hover:text-red-500">
            <Icon icon="material-symbols:delete-outline-rounded" width="18" />{$t("podcasts.delete_all")}
          </button>
        {/if}
      </div>
    {/if}
  </div>

  <div class="flex-1 min-h-0 overflow-y-auto scrollbar-app pl-4 md:pl-8 pr-10 md:pr-14 pt-2 pb-16 border-t border-(--rg-line)">
    {#if liste.length === 0}
      <p class="mt-8 max-w-md text-sm leading-relaxed text-(--rg-mu)">{$t("podcasts.no_downloads")}</p>
    {:else}
      {#each groupes as g (g.id)}
        <section class="mt-5 max-w-220">
          <div class="flex items-center gap-3 pb-2 border-b border-(--rg-line)">
            <a href="/podcasts/{g.id}" class="flex items-center gap-3 min-w-0 flex-1 group">
              <PodcastCover path={g.cover} size="1x" icone={18} class="w-10 h-10 shrink-0 rounded-lg" />
              <span class="min-w-0">
                <span class="block truncate text-[15px] font-bold text-(--rg-tx) group-hover:underline underline-offset-2">{g.titre}</span>
                <span class="block text-[12.5px] text-(--rg-mu)">{g.items.length.toLocaleString($currentLocale)} {$t(g.items.length === 1 ? "podcasts.episodes_one" : "podcasts.episodes_n")} · {taille(g.size)}</span>
              </span>
            </a>
            {#if confirmer === g.id}
              <button type="button" onclick={() => (confirmer = null)} class="h-8 px-2.5 rounded-lg cursor-pointer text-[13px] font-semibold text-(--rg-mu) hover:bg-(--rg-s2)">{$t("common.cancel")}</button>
              <button type="button" onclick={() => vider(g.id, false)} class="h-8 pl-2 pr-3 inline-flex items-center gap-1.5 rounded-lg cursor-pointer text-[13px] font-bold bg-red-600 text-white hover:bg-red-500"><Icon icon="material-symbols:delete-outline-rounded" width="17" />{$t("common.delete")}</button>
            {:else}
              <button type="button" onclick={() => (confirmer = g.id)} title={$t("podcasts.delete_podcast_downloads")} aria-label={$t("podcasts.delete_podcast_downloads")}
                      class="w-8 h-8 flex items-center justify-center rounded-lg cursor-pointer transition-colors text-(--rg-mu) hover:bg-(--rg-s2) hover:text-red-500">
                <Icon icon="material-symbols:delete-outline-rounded" width="19" />
              </button>
            {/if}
          </div>
          <ul>
            {#each g.items as d, i (d.id)}
              {@const enLecture = $player.pathFile === d.file_path}
              <li class="group flex items-center gap-3 py-2.5 border-b border-(--rg-line) last:border-b-0">
                <button type="button" onclick={() => play(d, g.items.slice(i + 1))} title={$t("podcasts.play")} aria-label={$t("podcasts.play")}
                        class="shrink-0 w-9 h-9 rounded-full flex items-center justify-center cursor-pointer transition-colors
                               {enLecture ? 'bg-(--rg-g) text-(--rg-on-g)' : 'bg-(--rg-s2) text-(--rg-tx) hover:bg-(--rg-g) hover:text-(--rg-on-g)'}">
                  <Icon icon="material-symbols:play-arrow-rounded" width="22" />
                </button>
                <span class="flex-1 min-w-0">
                  <span class="block truncate text-[14px] font-semibold {enLecture ? 'text-(--rg-gtx)' : d.played ? 'text-(--rg-mu)' : 'text-(--rg-tx)'}">{d.title}</span>
                  <span class="block truncate text-[12.5px] text-(--rg-mu)">
                    {[episodeDate(d.published_at, $currentLocale), episodeDuration(d.duration), d.played ? $t("podcasts.played") : null].filter(Boolean).join(" · ")}
                  </span>
                </span>
                <span class="shrink-0 text-[12.5px] tabular-nums text-(--rg-mu)">{taille(d.size)}</span>
                <button type="button" onclick={() => supprimer(d)} title={$t("podcasts.delete_download")} aria-label={$t("podcasts.delete_download")}
                        class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg cursor-pointer transition text-(--rg-mu)
                               opacity-0 group-hover:opacity-100 focus-visible:opacity-100 hover:bg-(--rg-s2) hover:text-red-500">
                  <Icon icon="material-symbols:close-rounded" width="18" />
                </button>
              </li>
            {/each}
          </ul>
        </section>
      {/each}
    {/if}
  </div>
</div>
{/if}
